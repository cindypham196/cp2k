&GLOBAL
  PROJECT LiF
  RUN_TYPE ENERGY
  PRINT_LEVEL LOW
&END GLOBAL
&FORCE_EVAL
  METHOD QS
  &DFT
    POTENTIAL_FILE_NAME GTH_POTENTIALS
    BASIS_SET_FILE_NAME GTH_BASIS_SETS
    MULTIPLICITY        1
    !ROKS                TRUE
    &QS
      TIDFT T
      EPS_DEFAULT 1.0E-12
    &END QS

    &TIDFT
      N_EXCITED_STATES           0 !2
      EPS_FILTER                 1.0E-8
      SPIN_PURE                  FALSE
      MAX_UNPAIR                 0
      SUGGESTED_MO_BLOCK_SIZE    34
      MO_GUESS                   ATOMIC !
      MO_GUESS_RANDOM_FRAC       0.05
      MO_GUESS_RANDOM_SEED       30304
      STATE_BY_STATE             TRUE
      PRE_ORTHOGONALIZE_STATES   FALSE
      NUMERICAL_GRADIENT         FALSE
      NUMERICAL_GRADIENT_DX      1E-6 ! run w diff vals 10e-4 to -7
      ENERGY_COMPONENT           TRUE
      INTRASTATE_COMPONENT       TRUE
      INTERSTATE_COMPONENT       TRUE

      &TIDFT_OPTIMIZER_PCG
        PRECONDITIONER             QHQ_S
        EPS_ERROR                  1.0E-8
        MAX_ITER                   50
        MAX_ITER_OUTER_LOOP        100
        LIN_SEARCH_EPS_ERROR       0.2
        LIN_SEARCH_STEP_SIZE_GUESS 0.05
        CONJUGATOR                 FLETCHER
      &END TIDFT_OPTIMIZER_PCG

      &PENALTY
        INTRASTATE_NON_PENALTY_STRENGTH    0.
        INTERSTATE_NON_PENALTY_STRENGTH    0.
        PENALTY_STRENGTH_INCREASE_FACTOR   2.0
        ALLOWED_DETERMINANT_DEVIATION      1E-4
      &END PENALTY
    &END TIDFT

    &MGRID
      CUTOFF 200 ! 320
      NGRIDS 5
    &END MGRID
    &XC
      &XC_FUNCTIONAL BLYP
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &SUBSYS
    &CELL
      ABC 4.0351 4.0351 4.0351
      MULTIPLE_UNIT_CELL 1 1 1 
    &END CELL
    &TOPOLOGY
      MULTIPLE_UNIT_CELL 1 1 1
    &END
    &COORD
      SCALED
      Li 0.0 0.0 0.0
      Li 0.5 0.5 0.0
      Li 0.5 0.0 0.5
      Li 0.0 0.5 0.5
      F  0.0 0.0 0.5
      F  0.0 0.5 0.0
      F  0.5 0.0 0.0
      F  0.5 0.5 0.5
    &END COORD
    &KIND Li
      BASIS_SET DZVP-GTH 
      POTENTIAL GTH-BLYP-q3
    &END KIND
    &KIND F
      BASIS_SET DZVP-GTH
      POTENTIAL GTH-BLYP-q7
    &END KIND
  &END SUBSYS
&END FORCE_EVAL

