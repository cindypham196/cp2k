&GLOBAL
  PROJECT Si
  RUN_TYPE ENERGY
  PRINT_LEVEL LOW
&END GLOBAL
&FORCE_EVAL
  METHOD QS
  &DFT
    BASIS_SET_FILE_NAME GTH_BASIS_SETS
    POTENTIAL_FILE_NAME POTENTIAL
    &MGRID
      CUTOFF 300
      NGRIDS 4
    &END MGRID
    &QS
      ALMO_SCF T
      EPS_DEFAULT 01.000E-12
    &END QS

    &ALMO_SCF

      EPS_FILTER                    01.000E-12
      ALMO_ALGORITHM                SKIP
      ALMO_SCF_GUESS                ATOMIC
      MO_OVERLAP_INV_ALG            DENSE_CHOLESKY
      XALMO_R_CUTOFF_FACTOR         0.6

      XALMO_ALGORITHM               PCG !!TRUST_REGION
      XALMO_TRIAL_WF                SIMPLE
      DELOCALIZE_METHOD             FULL_SCF

      RETURN_ORTHOGONALIZED_MOS     F

      &MATRIX_ITERATE
        EPS_TARGET_FACTOR        100.
        EPS_LANCZOS              1.0E-3
        MAX_ITER_LANCZOS         64
        ORDER_LANCZOS            3
      &END MATRIX_ITERATE

      &XALMO_PENALTY                       TRUE
        PENALTY_STRENGTH                   0.0
        DETERMINANT_TOLERANCE              0.0 ### IMPORTANT BUT ONLY FOR XALMO_SCF
        !PENALTY_STRENGTH_DECREASE_FACTOR  3.0
        !FINAL_DETERMINANT                 0.8
      &END XALMO_PENALTY

      &XALMO_OPTIMIZER_TRUSTR
        ALGORITHM                   CG              # options = CAUCHY, CG, DOGLEG
        MAX_ITER_OUTER_LOOP         100000
        EPS_ERROR                   1.0E-11
        CONJUGATOR                  FLETCHER        # important only for ALGORITHM = CG
        ETA                         0.25
        INITIAL_TRUST_RADIUS        0.1
        MAX_TRUST_RADIUS            2.0
        MAX_ITER                    1000            # important only for ALGORITHM = CG
        MODEL_GRAD_NORM_RATIO       0.2        # important only for ALGORITHM = CG
        PRECONDITIONER              DEFAULT         # important only for ALGORITHM = DOGLEG
      &END XALMO_OPTIMIZER_TRUSTR

      &XALMO_OPTIMIZER_PCG
        MAX_ITER                    100
        EPS_ERROR                   1.0E-8
        CONJUGATOR                  FLETCHER ! HESTENES_STIEFEL
        PRECONDITIONER              DEFAULT
        LIN_SEARCH_EPS_ERROR        0.2
        LIN_SEARCH_STEP_SIZE_GUESS  0.05
        MAX_ITER_OUTER_LOOP         2000
      &END XALMO_OPTIMIZER_PCG

    &END ALMO_SCF

    &SCF
      SCF_GUESS ATOMIC
      EPS_SCF 1.0E-7
      MAX_SCF 30
      &OT ON
        !ALGORITHM IRAC
        !MINIMIZER DIIS
        PRECONDITIONER FULL_ALL
      &END OT
      &OUTER_SCF
         EPS_SCF 1.0E-7
         MAX_SCF 5
      &END
      &PRINT
        &RESTART OFF
        &END
      &END
    &END SCF
    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &SUBSYS
    &CELL
      ABC 5.430710 5.430710 5.430710
      MULTIPLE_UNIT_CELL 1 1 1
    &END CELL
    &TOPOLOGY
      MULTIPLE_UNIT_CELL 1 1 1
    &END
    &COORD
      SCALED T
      Si         0.000000      0.000000      0.000000
      Si         0.000000      0.500000      0.500000
      Si         0.500000      0.000000      0.500000
      Si         0.500000      0.500000      0.000000
      Si         0.250000      0.250000      0.250000
      Si         0.250000      0.750000      0.750000
      Si         0.750000      0.250000      0.750000
      Si         0.750000      0.750000      0.250000
    &END COORD
    &KIND Si
      BASIS_SET DZVP-GTH
      POTENTIAL GTH-PBE-q4
    &END KIND
  &END SUBSYS
&END FORCE_EVAL

