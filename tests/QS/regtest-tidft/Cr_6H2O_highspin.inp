&GLOBAL
  PROJECT Cr(H2O)6
  RUN_TYPE ENERGY
  PRINT_LEVEL LOW
&END GLOBAL
&FORCE_EVAL
  METHOD QS
  &DFT
    BASIS_SET_FILE_NAME BASIS_MOLOPT_UZH
    POTENTIAL_FILE_NAME POTENTIAL

    CHARGE              2    ! RZK: I do not remember CHARGE, check it [Cr(H2O)6]2+
    MULTIPLICITY        1    ! RZK: I am not sure what multiplicites we decided to try. Compare energies for: 1,3,5 (or 2,4,6?)
    UKS                 T    ! == LSD?  RZK: UKS - compare to OT.
    !ROKS                T   ! RZK: Also, perform ROKS with TIDFT (same multiplicities)

    &MGRID
      CUTOFF 300
      NGRIDS 4
    &END MGRID

    &QS
      TIDFT T
      EPS_DEFAULT 1.0E-12
    &END QS

    &TIDFT
      N_EXCITED_STATES           0
      SUGGESTED_MO_BLOCK_SIZE    34
      EPS_FILTER                 1.0E-11
      SPIN_PURE                  FALSE
      MAX_UNPAIR                 4
      MO_GUESS_RANDOM_FRAC       0.05
      MO_GUESS_RANDOM_SEED       30304
      STATE_BY_STATE             TRUE
      PRE_ORTHOGONALIZE_STATES   FALSE
      NUMERICAL_GRADIENT         FALSE
      NUMERICAL_GRADIENT_DX      1E-6
      ENERGY_COMPONENT           TRUE
      INTRASTATE_COMPONENT       TRUE
      INTERSTATE_COMPONENT       TRUE

      &TIDFT_OPTIMIZER_PCG
        PRECONDITIONER             QHQ_S
        !WEIGHT_ALPHA_PREC          0.65
        EPS_ERROR                  1.0E-8
        MAX_ITER                   50
        MAX_ITER_OUTER_LOOP        100
        LIN_SEARCH_EPS_ERROR       0.2
        LIN_SEARCH_STEP_SIZE_GUESS 0.05
        CONJUGATOR                 FLETCHER
      &END TIDFT_OPTIMIZER_PCG

      &PENALTY
        INTRASTATE_NON_PENALTY_STRENGTH    1E-5
        WEIGHT_ALPHA_PREC          0.65
        INTERSTATE_NON_PENALTY_STRENGTH    1
        PENALTY_STRENGTH_INCREASE_FACTOR   2.0
        ALLOWED_DETERMINANT_DEVIATION      1E-4
        MAX_CP_STEP                             3
        LOOSE_EPS_SCF                     1E-2
      &END PENALTY

    &END TIDFT

    &SCF
      SCF_GUESS ATOMIC
      EPS_SCF 1.0E-7
      MAX_SCF 50 !30
      &OT ON
        !ALGORITHM IRAC
        !MINIMIZER DIIS
        PRECONDITIONER  FULL_SINGLE_INVERSE !FULL_ALL is not compatible with ROTATION
        ROTATION T      ! Restricted calculation with OT requires orbital rotation
      &END OT
      &OUTER_SCF
         EPS_SCF 1.0E-7
         MAX_SCF 20 !5
      &END
      &PRINT
        &RESTART OFF
        &END
      &END
    &END SCF
    &XC ! RZK: Change to HSE functional 
      &XC_FUNCTIONAL PBE !B3LYP
        !&HYB_GGA_XC_HSE06 T ! did not work
        !&END HYB_GGA_XC_HSE06
       ! &PBE
        !SCALE_X 0.0
        !SCALE_C 1.0
        !&END PBE

        !&XWPBE
        !SCALE_X -0.25
        !SCALE_X0 1.0
        !OMEGA 0.11
        !&END XWPBE
      &END XC_FUNCTIONAL

      !&HF
        !&SCREENING
        !EPS_SCHWARZ 1.0E-6
        !SCREEN_ON_INITIAL_P FALSE
        !&END SCREENING

        !&INTERACTION_POTENTIAL
        !POTENTIAL_TYPE SHORTRANGE
        !OMEGA 0.11
        !&END INTERACTION_POTENTIAL

        !&MEMORY
        !MAX_MEMORY 2400
        !EPS_STORAGE_SCALING 0.1
        !&END MEMORY

        !FRACTION 0.25
      !&END HF
    &END XC
  &END DFT
  &SUBSYS
    &CELL
      ABC 10.1775 10.1775 10.1775   ! RZK: It is OK to round of to 10.0
      MULTIPLE_UNIT_CELL 1 1 1
    &END CELL
    &TOPOLOGY
      MULTIPLE_UNIT_CELL 1 1 1
    &END
    &COORD
         Cr                 2.62666085    2.63704419    2.61896813
          O                  2.62666085    2.63704419    4.40896813
          H                  1.75180187    2.86903934    4.72896813
          O                  0.83666085    2.63704419    2.61896813
          H                  0.51666085    2.19870392    1.82709832
          O                  2.62666085    4.42704419    2.61896813
          H                  2.60136617    4.74704419    1.71422498
          O                  2.62666085    2.63704419    0.82896813
          H                  2.84972008    1.75986429    0.50896813
          O                  4.41666085    2.63704419    2.61896813
          H                  4.73666085    1.81071477    2.24967193
          O                  2.62666085    0.84704419    2.61896813
          H                  2.45404202    0.52704419    3.50745153
          H                  1.85577764    4.74704419    3.09324555
          H                  0.51666085    2.17043494    3.39451685
          H                  2.86317665    1.76339650    4.72896813
          H                  3.48241946    0.52704419    2.32421873
          H                  4.73666085    3.37002879    2.08799397
          H                  1.75547116    2.88245918    0.50896813
    &END COORD
    ! RZK: For singlet, break the simmetry of the initial guess...
    &KIND Cr
      BASIS_SET TZV2P-MOLOPT-PBE-GTH-q14 !DZVP-MOLOPT-SR-GTH
      POTENTIAL GTH-BLYP-q14
      &BS 
        &ALPHA ! Modification to the spin-up initial MOs 
          NEL +2 ! Transfer 2 beta electrons to alpha (on Cr cation)
          N 3
          L 2
        &END ALPHA
        &BETA ! Modification to the spin-down initial MOs 
          NEL -2 ! Transfer 2 beta electrons to alpha (on Cr cation)
          N 3
          L 2
        &END BETA
      &END BS 

    &END KIND
    &KIND H
      BASIS_SET TZV2P-MOLOPT-PBE-GTH-q1
      POTENTIAL GTH-BLYP-q1
    &END KIND
    &KIND O
      BASIS_SET TZV2P-MOLOPT-PBE-GTH-q6
      POTENTIAL GTH-BLYP-q6
    &END KIND
    
  &END SUBSYS
&END FORCE_EVAL

