&GLOBAL
  PROJECT Cr(H2O)6
  RUN_TYPE ENERGY
  PRINT_LEVEL LOW
&END GLOBAL
&FORCE_EVAL
  METHOD QS
  &DFT
    BASIS_SET_FILE_NAME BASIS_MOLOPT_COMBINED  !GTH_BASIS_SETS
    POTENTIAL_FILE_NAME POTENTIAL
    &MGRID
      CUTOFF 300
      NGRIDS 4
    &END MGRID
    !UKS                  F
    ROKS                T
    &QS
      TIDFT T
      EPS_DEFAULT 1.0E-12
    &END QS

    &TIDFT
      N_EXCITED_STATES           0
      SUGGESTED_MO_BLOCK_SIZE    34
      EPS_FILTER                 1.0E-11
      SPIN_PURE                  FALSE
      MAX_UNPAIR                 0
      MO_GUESS_RANDOM_FRAC       0.05
      MO_GUESS_RANDOM_SEED       30304
      STATE_BY_STATE             TRUE
      PRE_ORTHOGONALIZE_STATES   FALSE
      NUMERICAL_GRADIENT         FALSE
      NUMERICAL_GRADIENT_DX      1E-6
      ENERGY_COMPONENT           TRUE
      INTRASTATE_COMPONENT       TRUE
      INTERSTATE_COMPONENT       TRUE

      &TIDFT_OPTIMIZER_PCG
        PRECONDITIONER             QHQ_S
        EPS_ERROR                  1.0E-8
        MAX_ITER                   50
        MAX_ITER_OUTER_LOOP        100
        LIN_SEARCH_EPS_ERROR       0.2
        LIN_SEARCH_STEP_SIZE_GUESS 0.05
        CONJUGATOR                 FLETCHER
      &END TIDFT_OPTIMIZER_PCG

      &PENALTY
        INTRASTATE_NON_PENALTY_STRENGTH    1E-5
        INTERSTATE_NON_PENALTY_STRENGTH    1
        PENALTY_STRENGTH_INCREASE_FACTOR   2.0
        ALLOWED_DETERMINANT_DEVIATION      1E-4
        MAX_CP_STEP                             3
        LOOSE_EPS_SCF                     1E-2
      &END PENALTY

    &END TIDFT

    &SCF
      SCF_GUESS ATOMIC
      EPS_SCF 1.0E-7
      MAX_SCF 30
      &OT ON
        !ALGORITHM IRAC
        !MINIMIZER DIIS
        PRECONDITIONER FULL_ALL
      &END OT
      &OUTER_SCF
         EPS_SCF 1.0E-7
         MAX_SCF 5
      &END
      &PRINT
        &RESTART OFF
        &END
      &END
    &END SCF
    &XC
      &XC_FUNCTIONAL BLYP
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &SUBSYS
    &CELL
      ABC 12.033685  11.449481   11.642905
      MULTIPLE_UNIT_CELL 1 1 1
    &END CELL
    &TOPOLOGY
      MULTIPLE_UNIT_CELL 1 1 1
    &END
    &COORD
      Cr      2.904600    2.790100    2.812500
      O       2.904600    4.580100    2.812500
      H       2.264600    4.900600    3.452300
      O       2.904600    2.790100    4.602500
      H       3.005000    3.689500    4.923000
      O       2.904600    1.000100    2.812500
      H       2.910200    0.679700    3.717400
      O       4.694600    2.790100    2.812500
      H       5.015100    2.610500    3.699400
      O       2.904600    2.790100    1.022500
      H       3.809200    2.762800    0.702100
      O       1.114600    2.790100    2.812500
      H       0.794200    2.248700    2.087400
      H       1.997600    2.739300    4.923200
      H       0.641900    2.411000    3.557100
      H       2.868700    2.185000    0.278200
      H       3.838600    4.796600    2.762500
      H       5.476500    2.890100    2.264400
      H       3.293700    0.349300    2.223700
    &END COORD
    &KIND Cr
      BASIS_SET TZV2P-MOLOPT-SR-GTH
      POTENTIAL GTH-BLYP-q14
    &END KIND
    &KIND H
      BASIS_SET DZVP-MOLOPT-GTH
      POTENTIAL GTH-BLYP-q1
    &END KIND
    &KIND O
      BASIS_SET DZVP-MOLOPT-GTH
      POTENTIAL GTH-BLYP-q6
    &END KIND
  &END SUBSYS
&END FORCE_EVAL

