&GLOBAL
  PROJECT LiF
  RUN_TYPE ENERGY
  PRINT_LEVEL LOW
&END GLOBAL
&FORCE_EVAL
  METHOD QS
  &DFT
    POTENTIAL_FILE_NAME GTH_POTENTIALS
    BASIS_SET_FILE_NAME GTH_BASIS_SETS
    MULTIPLICITY        1
    !ROKS                TRUE
    &QS
      TIDFT T
      EPS_DEFAULT 1.0E-12
    &END QS

    &TIDFT
      N_EXCITED_STATES           2
      EPS_FILTER                 1.0E-8
      SPIN_PURE                  TRUE
      MAX_UNPAIR                 0
    &END TIDFT

    &MGRID
      CUTOFF 200 ! 320
      NGRIDS 5
    &END MGRID
    &XC
      &XC_FUNCTIONAL BLYP
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &SUBSYS
    &CELL
      ABC 4.0351 4.0351 4.0351
      MULTIPLE_UNIT_CELL 1 1 1 
    &END CELL
    &TOPOLOGY
      MULTIPLE_UNIT_CELL 1 1 1
    &END
    &COORD
      SCALED
      Li 0.0 0.0 0.0
      Li 0.5 0.5 0.0
      Li 0.5 0.0 0.5
      Li 0.0 0.5 0.5
      F  0.0 0.0 0.5
      F  0.0 0.5 0.0
      F  0.5 0.0 0.0
      F  0.5 0.5 0.5
    &END COORD
    &KIND Li
      BASIS_SET DZVP-GTH 
      POTENTIAL GTH-BLYP-q3
    &END KIND
    &KIND F
      BASIS_SET DZVP-GTH
      POTENTIAL GTH-BLYP-q7
    &END KIND
  &END SUBSYS
&END FORCE_EVAL

