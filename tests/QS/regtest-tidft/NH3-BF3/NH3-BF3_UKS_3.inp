&GLOBAL
  PROJECT NH3-BF3
  RUN_TYPE ENERGY  !GEO_OPT ! 
  PRINT_LEVEL MEDIUM !LOW
&END GLOBAL

!&MOTION
!  &GEO_OPT
!     OPTIMIZER  LBFGS
!     MAX_ITER  2000
!     MAX_DR     3.000000000000000E-03
!     MAX_FORCE     4.5000000000000000E-04
!     RMS_DR     1.5000000000000000E-03
!     RMS_FORCE    3.00000000000000E-04
!  &END GEO_OPT
!  
!  &CONSTRAINT
!    &FIXED_ATOMS
!      !COMPONENTS_TO_FIX X
!      LIST 1 2
!    &END
!  &END
!
! &END MOTION

&FORCE_EVAL
  METHOD QS
!  STRESS_TENSOR  ANALYTICAL

!  &PROPERTIES
!    &TDDFPT
!      NSTATES     5 !10             # number of excited states
!      MAX_ITER    50             # maximum number of Davidson iterations
!      CONVERGENCE [eV] 1.0e-6    # convergence on maximum energy change between iterations
!      &MGRID
!          CUTOFF 300              # separate cutoff for TDDFPT calc
!      &END
!    &END TDDFPT
!  &END PROPERTIES

  &DFT
    POTENTIAL_FILE_NAME             GTH_POTENTIALS
    BASIS_SET_FILE_NAME             GTH_BASIS_SETS
    MULTIPLICITY                    3
    UKS                 T    ! == LSD?  RZK: UKS - compare to OT.
    !ROKS                T   ! RZK: Also, perform ROKS with TIDFT (same multiplicities)

    &MGRID
      CUTOFF 300
      NGRIDS 4
    &END MGRID

    &QS
      TIDFT  T !F !
      EPS_DEFAULT 1.0E-11
    &END QS

    &TIDFT
      N_EXCITED_STATES           4
      SUGGESTED_MO_BLOCK_SIZE    7
      EPS_FILTER                 1.0E-10
      SPIN_PURE                  FALSE
      MAX_UNPAIR                 1
      MO_GUESS_RANDOM_FRAC       0.05
      MO_GUESS_RANDOM_SEED       30304
      STATE_BY_STATE             TRUE
      PRE_ORTHOGONALIZE_STATES   FALSE
      NUMERICAL_GRADIENT         FALSE
      NUMERICAL_GRADIENT_DX      1E-9
      ENERGY_COMPONENT           TRUE
      INTRASTATE_COMPONENT       TRUE
      INTERSTATE_COMPONENT       TRUE

      &TIDFT_OPTIMIZER_PCG
        PRECONDITIONER             QHQ_S
        PREC_WEIGHT_OVERLAP        0.85
        EPS_ERROR                  1.0E-6
        WHICH_GRADIENT_NORM        RMS
        MAX_ITER                   150
        MAX_ITER_OUTER_LOOP        200
        LIN_SEARCH_EPS_ERROR       0.2
        LIN_SEARCH_STEP_SIZE_GUESS 0.05
        CONJUGATOR                 FLETCHER
      &END TIDFT_OPTIMIZER_PCG

      &PENALTY
        INTRASTATE_NON_PENALTY_STRENGTH    1.0E-5
        INTERSTATE_NON_PENALTY_STRENGTH    10 !1.0E-1 !1.0E-3
        PENALTY_STRENGTH_INCREASE_FACTOR   2.0
        ALLOWED_DETERMINANT_DEVIATION      1E-4
        MAX_CP_STEP                         1 !4
        LOOSE_EPS_SCF                     1E-2
      &END PENALTY

      &WF_GUESS
        MAX_EXC_ENERGY    1000.00
        MIN_EXC_ENERGY    0.00
        MAX_EXC_ORDER     1 !2
      &END WF_GUESS

    &END TIDFT

    &SCF
      SCF_GUESS ATOMIC
      EPS_SCF 1.0E-6
      MAX_SCF 50
      &OT ON
        !ALGORITHM IRAC
        !MINIMIZER DIIS
        PRECONDITIONER FULL_SINGLE_INVERSE !FULL_ALL
        ROTATION T
      &END OT
      &OUTER_SCF
         EPS_SCF 1.0E-6
         MAX_SCF 20
      &END
      &PRINT
        &RESTART OFF
        &END
      &END
    &END SCF

    &POISSON
      PERIODIC NONE
      PSOLVER  MULTIPOLE !WAVELET
    &END POISSON

    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &SUBSYS
    &CELL
      ABC 25.0  8.0  8.0 ! long x for CT !8 8 8
      MULTIPLE_UNIT_CELL 1 1 1
      PERIODIC NONE
    &END CELL
    &TOPOLOGY
      MULTIPLE_UNIT_CELL 1 1 1
      &CENTER_COORDINATES T
      &END
    &END
    &COORD ! opted coords
    B        11.7866666600        4.0000000000        3.7195398800
    N        13.3666666600        4.0000000000        3.7195398800
    H        13.7286684764        3.1676506933        4.2134497818
    H        13.7189409387        3.9867673634        2.7481770184
    H        13.7266590842        4.8465654658        4.1902833705
    F        11.3928637963        5.1573912077        3.0241214051
    F        11.3915632644        4.0000121326        5.0657859779
    F        11.3928169878        2.8426231008        3.0241234493
! before opted coords
! B                  3.91285714    4.00000000    4.00000000
! N                  5.49285714    4.00000000    4.00000000
! H                  5.82619048    3.53017960    4.81740913
! H                  5.82619048    3.52701313    3.18441904
! H                  5.82619048    4.94280727    3.99817184
! F                  3.42619048    5.19208501    3.31174940
! F                  3.42619048    4.00000000    5.37650120
! F                  3.42619048    2.80791499    3.31174940
    &END COORD
    &KIND F
      BASIS_SET SZV-GTH-q7   !DZVP-GTH
      POTENTIAL GTH-BLYP-q7
    &END KIND
    &KIND N
      BASIS_SET SZV-GTH-q5  !DZVP-GTH
      POTENTIAL GTH-BLYP-q5
    &END KIND
    &KIND H
      BASIS_SET SZV-GTH-q1  !DZVP-GTH
      POTENTIAL GTH-BLYP-q1
    &END KIND    
    &KIND B
      BASIS_SET SZV-GTH-q3  !DZVP-GTH
      POTENTIAL GTH-BLYP-q3
    &END KIND
  &END SUBSYS
&END FORCE_EVAL

