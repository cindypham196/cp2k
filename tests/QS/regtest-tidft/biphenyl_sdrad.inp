&GLOBAL
  PROJECT biphenyl_sdrad
  RUN_TYPE ENERGY
  PRINT_LEVEL LOW
&END GLOBAL
&FORCE_EVAL
  METHOD QS
  &DFT
    BASIS_SET_FILE_NAME GTH_BASIS_SETS
    POTENTIAL_FILE_NAME POTENTIAL
    &MGRID
      CUTOFF 300
      NGRIDS 4
    &END MGRID
    UKS                  F
    !ROKS                T
    &QS
      TIDFT T
      EPS_DEFAULT 1.0E-12
    &END QS

    &TIDFT
      N_EXCITED_STATES           0
      SUGGESTED_MO_BLOCK_SIZE    34
      EPS_FILTER                 1.0E-11
      SPIN_PURE                  FALSE
      MAX_UNPAIR                 0
      MO_GUESS_RANDOM_FRAC       0.05
      MO_GUESS_RANDOM_SEED       30304
      STATE_BY_STATE             TRUE
      PRE_ORTHOGONALIZE_STATES   FALSE
      NUMERICAL_GRADIENT         FALSE
      NUMERICAL_GRADIENT_DX      1E-6
      ENERGY_COMPONENT           TRUE
      INTRASTATE_COMPONENT       TRUE
      INTERSTATE_COMPONENT       TRUE

      &TIDFT_OPTIMIZER_PCG
        PRECONDITIONER             QHQ_S
        EPS_ERROR                  1.0E-8
        MAX_ITER                   50
        MAX_ITER_OUTER_LOOP        100
        LIN_SEARCH_EPS_ERROR       0.2
        LIN_SEARCH_STEP_SIZE_GUESS 0.05
        CONJUGATOR                 FLETCHER
      &END TIDFT_OPTIMIZER_PCG

      &PENALTY
        INTRASTATE_NON_PENALTY_STRENGTH    1E-5
        INTERSTATE_NON_PENALTY_STRENGTH    1
        PENALTY_STRENGTH_INCREASE_FACTOR   2.0
        ALLOWED_DETERMINANT_DEVIATION      1E-4
        CP_STEP                             3
        TIGHTEN_EPS_SCF                     1E-2
      &END PENALTY

    &END TIDFT

    &SCF
      SCF_GUESS ATOMIC
      EPS_SCF 1.0E-7
      MAX_SCF 30
      &OT ON
        !ALGORITHM IRAC
        !MINIMIZER DIIS
        PRECONDITIONER FULL_ALL
      &END OT
      &OUTER_SCF
         EPS_SCF 1.0E-7
         MAX_SCF 5
      &END
      &PRINT
        &RESTART OFF
        &END
      &END
    &END SCF
    &XC
      &XC_FUNCTIONAL BLYP
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &SUBSYS
    &CELL
      ABC 15.0795 14.78295  14.5827
      MULTIPLE_UNIT_CELL 1 1 1
    &END CELL
    &TOPOLOGY
      MULTIPLE_UNIT_CELL 1 1 1
    &END
    &COORD
      O       0.222700    2.135100    4.544200
      O       4.210900    2.175600    9.180100
      N       1.483900    1.937400    4.806100
      N       4.159800    0.934600    8.817500
      C       1.753700    1.124100    5.975300
      C       2.791200    1.448000    6.857600
      C       3.054000    0.597700    7.927200
      C       2.268900   -0.534000    8.161800
      C       1.191200   -0.839300    7.307800
      C       0.957900   -0.002600    6.210000
      C       0.346400   -2.054000    7.547500
      C      -0.306300   -2.695900    6.482900
      C      -1.060300   -3.850300    6.695500
      C      -1.178800   -4.382500    7.976500
      C      -0.552100   -3.757100    9.042100
      C       0.203600   -2.597000    8.838600
      C       2.418600    1.806700    3.601500
      C       1.951500    2.774000    2.521900
      C       2.319300    0.359100    3.102000
      C       3.855800    2.139000    4.030600
      C       5.482300    0.192600    8.622100
      C       5.283600   -1.308400    8.893000
      C       6.503300    0.760500    9.589000
      C       5.939100    0.414000    7.171800
      H       3.300100    2.257500    6.747800
      H       2.432900   -1.044300    8.913200
      H       0.232300   -0.154800    5.609800
      H      -0.236800   -2.349600    5.609800
      H      -1.484900   -4.253500    6.012600
      H      -1.663700   -5.181400    8.127600
      H      -0.635800   -4.063900    9.890100
      H       0.606900   -2.163700    9.658500
      H       2.527900    2.623300    1.782600
      H       2.059600    3.673900    2.809900
      H       0.987300    2.571100    2.245900
      H       1.320300    0.139900    2.799800
      H       2.673600   -0.261400    3.796900
      H       2.878700    0.276100    2.245900
      H       4.419500    2.162100    3.182600
      H       3.957800    3.058800    4.461600
      H       4.277100    1.414200    4.733500
      H       4.696100   -1.628600    8.248500
      H       6.203100   -1.792200    8.822500
      H       4.904200   -1.399400    9.839700
      H       6.646200    1.743500    9.447000
      H       6.251800    0.598000   10.504400
      H       7.389300    0.316600    9.457000
      H       6.809300    0.051700    7.019700
      H       5.986900    1.388300    6.929100
      H       5.316400    0.026200    6.496000
    &END COORD
    &KIND C
      BASIS_SET DZVP-GTH
      POTENTIAL GTH-BLYP-q4
    &END KIND
    &KIND O
      BASIS_SET DZVP-GTH
      POTENTIAL GTH-BLYP-q6
    &END KIND
     &KIND N
      BASIS_SET DZVP-GTH
      POTENTIAL GTH-BLYP-q5
    &END KIND
     &KIND H
      BASIS_SET DZVP-GTH
      POTENTIAL GTH-BLYP-q1
    &END KIND
  &END SUBSYS
&END FORCE_EVAL

