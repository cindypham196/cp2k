&GLOBAL
  PROJECT O3
  RUN_TYPE ENERGY
  PRINT_LEVEL LOW
&END GLOBAL

&FORCE_EVAL
  METHOD QS
  &DFT

    BASIS_SET_FILE_NAME GTH_BASIS_SETS
    POTENTIAL_FILE_NAME POTENTIAL
    MULTIPLICITY        1
    UKS                 F
    !ROKS                T

    &QS
      ALMO_SCF    T
      EPS_DEFAULT 1.0E-12
    &END QS

    &MGRID
      CUTOFF 300
    &END MGRID

    &ALMO_SCF

      EPS_FILTER                 1.0E-16 !1.0E-12
      ALMO_ALGORITHM             SKIP
      ALMO_SCF_GUESS             ATOMIC
      MO_OVERLAP_INV_ALG         DENSE_CHOLESKY
      XALMO_R_CUTOFF_FACTOR      1.0
      XALMO_TRIAL_WF             SIMPLE
      DELOCALIZE_METHOD          FULL_SCF
      XALMO_ALGORITHM            PCG !!TRUST_REGION

      &XALMO_OPTIMIZER_PCG
        MAX_ITER                 50
        EPS_ERROR                1.0E-8
        CONJUGATOR               FLETCHER
        PRECONDITIONER           DEFAULT
        LIN_SEARCH_EPS_ERROR     0.2
        LIN_SEARCH_STEP_SIZE_GUESS 0.05
        MAX_ITER_OUTER_LOOP      100
      &END XALMO_OPTIMIZER_PCG

      &XALMO_PENALTY                       TRUE
        PENALTY_STRENGTH                   0.0
        DETERMINANT_TOLERANCE              0.0 ### IMPORTANT BUT ONLY FOR XALMO_SCF
        !PENALTY_STRENGTH_DECREASE_FACTOR  3.0
        !FINAL_DETERMINANT                 0.8
      &END XALMO_PENALTY

    &END ALMO_SCF

    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
    &END XC

    &SCF
      SCF_GUESS ATOMIC
      EPS_SCF 1.0E-8
      MAX_SCF 50
      &OT ON
        !ALGORITHM IRAC
        !MINIMIZER DIIS
        PRECONDITIONER FULL_ALL
      &END OT
      &OUTER_SCF
         EPS_SCF 1.0E-8
         MAX_SCF 5
      &END
      &PRINT
        &RESTART OFF
        &END
      &END
    &END SCF

  &END DFT

  &SUBSYS

    &KIND O
      BASIS_SET DZVP-GTH ! TZV2P-GTH
      POTENTIAL GTH-BLYP-q6
    &END KIND

    &CELL
      ABC  8.00000000       10.00000000       9.0000000
      MULTIPLE_UNIT_CELL 1 1 1
    &END CELL

    &TOPOLOGY
      &GENERATE # fragments contain single atoms
        BONDLENGTH_MAX 1.0
        BONDPARM COVALENT
        BONDPARM_FACTOR 0.3
      &END GENERATE
      MULTIPLE_UNIT_CELL 1 1 1
    &END

    &COORD
      O     0.00000000   -0.00000000    0.50516102
      O     0.00000000    1.06551482   -0.25258050
      O    -0.00000000   -1.06551482   -0.25258050
      !C  0.00  0.00  0.00
      !O  0.00  0.00  1.16
      !O  0.00  0.00 -1.16
    &END COORD

  &END SUBSYS

&END FORCE_EVAL

