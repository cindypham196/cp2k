&GLOBAL
  PROJECT Cu
  RUN_TYPE ENERGY
  PRINT_LEVEL LOW
  EXTENDED_FFT_LENGTHS TRUE
&END GLOBAL

&FORCE_EVAL

  METHOD QS

  &DFT

    BASIS_SET_FILE_NAME BASIS_MOLOPT
    POTENTIAL_FILE_NAME POTENTIAL

    MULTIPLICITY        1

    &QS
      TIDFT                      F     ! RZK: main switch between TIDFT code and OT
      EPS_DEFAULT                1.0E-11
    &END QS

    &TIDFT
      N_EXCITED_STATES           0
      SUGGESTED_MO_BLOCK_SIZE    16           
      EPS_FILTER                 1.0E-10    
      SPIN_PURE                  FALSE
      MAX_UNPAIR                 0
      MO_GUESS                   ATOMIC
      MO_GUESS_RANDOM_FRAC       0.05
      MO_GUESS_RANDOM_SEED       30304
      STATE_BY_STATE             TRUE
      PRE_ORTHOGONALIZE_STATES   FALSE
      NUMERICAL_GRADIENT         FALSE
      NUMERICAL_GRADIENT_DX      1E-6
      ENERGY_COMPONENT           TRUE
      INTRASTATE_COMPONENT       TRUE
      INTERSTATE_COMPONENT       FALSE

      &TIDFT_OPTIMIZER_PCG
        PRECONDITIONER             QHQ_S 
        EPS_ERROR                  1.0E-8
        WHICH_GRADIENT_NORM        RMS
        MAX_ITER                   50
        MAX_ITER_OUTER_LOOP        20
        LIN_SEARCH_EPS_ERROR       0.2
        LIN_SEARCH_STEP_SIZE_GUESS 0.05
        CONJUGATOR                 FLETCHER
      &END TIDFT_OPTIMIZER_PCG

      &PENALTY
        INTRASTATE_NON_PENALTY_STRENGTH    1E-5     
        INTERSTATE_NON_PENALTY_STRENGTH    0.
        PENALTY_STRENGTH_INCREASE_FACTOR   2.0
        ALLOWED_DETERMINANT_DEVIATION      1E-4
      &END PENALTY

    &END TIDFT

    &SCF
      EPS_SCF 1.0E-7     ! RZK: OT code must use absolute max norm, not rms norm
      MAX_SCF 50
      SCF_GUESS ATOMIC
      &OUTER_SCF
        EPS_SCF 1.0E-7
        MAX_SCF 20
      &END OUTER_SCF
      &OT ON
        !ALGORITHM IRAC
        PRECONDITIONER FULL_SINGLE
        ENERGY_GAP   -1.0
        MINIMIZER CG ! DIIS
      &END OT
      &PRINT
        &RESTART OFF
        &END
      &END
    &END SCF

    &MGRID
      CUTOFF 650 !300
      NGRIDS 5
      REL_CUTOFF 50  
    &END MGRID
    

    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
    &END XC
    !&KPOINTS
     !SCHEME MONKHORST-PACK 1 1 1 !15 15 15             
    !&END KPOINTS
  &END DFT

  &SUBSYS

    &CELL
      ABC 14.4 14.4 14.4
      MULTIPLE_UNIT_CELL 1 1 1 ! 10 10 10
    &END CELL

    &TOPOLOGY
      MULTIPLE_UNIT_CELL 1 1 1 ! 10 10 10
    &END

    &COORD
    !@INCLUDE 'Cu.xyz' 
    ! Change to fractional coords with smaller FCC cell
    Cu                 0.00000000    0.00000000    0.00000000
