&GLOBAL
  PROJECT PTM_radical
  RUN_TYPE ENERGY
  PRINT_LEVEL LOW
&END GLOBAL
&FORCE_EVAL
  METHOD QS
  &DFT
    BASIS_SET_FILE_NAME GTH_BASIS_SETS
    POTENTIAL_FILE_NAME POTENTIAL
    &MGRID
      CUTOFF 300
      NGRIDS 4
    &END MGRID
    UKS                  T !F
    !ROKS                T
    &QS
      TIDFT T
      EPS_DEFAULT 1.0E-12
    &END QS

    &TIDFT
      N_EXCITED_STATES           0
      SUGGESTED_MO_BLOCK_SIZE    34
      EPS_FILTER                 1.0E-11
      SPIN_PURE                  FALSE
      MAX_UNPAIR                 0
      MO_GUESS_RANDOM_FRAC       0.05
      MO_GUESS_RANDOM_SEED       30304
      STATE_BY_STATE             TRUE
      PRE_ORTHOGONALIZE_STATES   FALSE
      NUMERICAL_GRADIENT         FALSE
      NUMERICAL_GRADIENT_DX      1E-6
      ENERGY_COMPONENT           TRUE
      INTRASTATE_COMPONENT       TRUE
      INTERSTATE_COMPONENT       TRUE

      &TIDFT_OPTIMIZER_PCG
        PRECONDITIONER             QHQ_S
        EPS_ERROR                  1.0E-8
        MAX_ITER                   50
        MAX_ITER_OUTER_LOOP        100
        LIN_SEARCH_EPS_ERROR       0.2
        LIN_SEARCH_STEP_SIZE_GUESS 0.05
        CONJUGATOR                 FLETCHER
      &END TIDFT_OPTIMIZER_PCG

      &PENALTY
        INTRASTATE_NON_PENALTY_STRENGTH    1E-5
        INTERSTATE_NON_PENALTY_STRENGTH    1
        PENALTY_STRENGTH_INCREASE_FACTOR   2.0
        ALLOWED_DETERMINANT_DEVIATION      1E-4
        MAX_CP_STEP                             3
        LOOSE_EPS_SCF                     1E-2
      &END PENALTY

    &END TIDFT

    &SCF
      SCF_GUESS ATOMIC
      EPS_SCF 1.0E-7
      MAX_SCF 30
      &OT ON
        !ALGORITHM IRAC
        !MINIMIZER DIIS
        PRECONDITIONER FULL_ALL
      &END OT
      &OUTER_SCF
         EPS_SCF 1.0E-7
         MAX_SCF 5
      &END
      &PRINT
        &RESTART OFF
        &END
      &END
    &END SCF
    &XC
      &XC_FUNCTIONAL BLYP
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &SUBSYS
    &CELL
      ABC 13.60215  15.9771 15.5388
      MULTIPLE_UNIT_CELL 3 2 1
    &END CELL
    &TOPOLOGY
      MULTIPLE_UNIT_CELL 3 2 1
    &END
    &COORD
      Cl      0.160600    5.471100    2.471400
      Cl      2.093100    3.855000    4.250700
      Cl      5.312900    8.211900    4.610800
      Cl      3.234500    9.828400    2.974900
      Cl      4.488500    2.859000    6.996200
      Cl      5.659200    0.246600    5.855800
      Cl      6.826900    0.177000    2.973200
      Cl      6.803400    2.734300    1.241000
      Cl      5.660500    5.341600    2.319900
      Cl      2.285500    5.888800    7.081600
      Cl      2.987800    7.129100    9.781600
      Cl      5.954900    7.553300   10.600200
      Cl      8.228700    6.610600    8.703300
      Cl      7.559300    5.503700    5.890800
      C       1.813600    7.553600    2.827700
      C       1.586300    6.218500    3.083300
      C       2.486900    5.477500    3.855900
      C       3.644800    6.084400    4.371400
      C       3.860200    7.430500    4.090400
      C       2.952800    8.172900    3.326300
      C       4.596600    5.295300    5.180700
      C       5.136000    4.047300    4.663800
      C       5.184600    2.874300    5.434900
      C       5.691100    1.682400    4.915200
      C       6.186300    1.635500    3.615800
      C       6.153600    2.779600    2.833300
      C       5.627200    3.957500    3.334700
      C       4.944100    5.799400    6.529500
      C       3.937000    6.172300    7.443300
      C       4.259500    6.705300    8.700300
      C       5.574600    6.856000    9.066100
      C       6.582100    6.448200    8.213100
      C       6.274100    5.925100    6.967300
      Cl      0.633700    8.500200    1.928100
    &END COORD
    &KIND C
      BASIS_SET DZVP-GTH
      POTENTIAL GTH-BLYP-q4
    &END KIND
    &KIND Cl
      BASIS_SET DZVP-GTH
      POTENTIAL GTH-BLYP-q7
    &END KIND
  &END SUBSYS
&END FORCE_EVAL

