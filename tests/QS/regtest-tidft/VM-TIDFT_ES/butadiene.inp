&GLOBAL
  PROJECT butadiene
  RUN_TYPE ENERGY  !GEO_OPT !
  PRINT_LEVEL LOW
&END GLOBAL

!&MOTION
!  &GEO_OPT
!     OPTIMIZER  LBFGS
!     MAX_ITER  2000
!     MAX_DR     3.000000000000000E-03
!     MAX_FORCE     4.5000000000000000E-04
!     RMS_DR     1.5000000000000000E-03
!     RMS_FORCE    3.00000000000000E-04
!  &END GEO_OPT
!
!&END MOTION

&FORCE_EVAL
  METHOD QS
!  STRESS_TENSOR  ANALYTICAL

!  &PROPERTIES
!    &TDDFPT
!      NSTATES     10             # number of excited states
!      MAX_ITER    50             # maximum number of Davidson iterations
!      CONVERGENCE [eV] 1.0e-6    # convergence on maximum energy change between iterations
!      &MGRID
!          CUTOFF 300              # separate cutoff for TDDFPT calc
!      &END
!    &END TDDFPT
!  &END PROPERTIES


  &DFT
    BASIS_SET_FILE_NAME GTH_BASIS_SETS
    POTENTIAL_FILE_NAME POTENTIAL
    &MGRID
      CUTOFF 300
      NGRIDS 4
    &END MGRID
    CHARGE               0
    !MULTIPLICITY         1 !3
    UKS                  T ! RZK: Perform the same calculations as for CH2, NH2+, OH+ diradicals
    !ROKS                 T
    &QS
      TIDFT  T
      EPS_DEFAULT 1.0E-12
    &END QS

    &TIDFT
      N_EXCITED_STATES           10 !20
      SUGGESTED_MO_BLOCK_SIZE    5
      EPS_FILTER                 1.0E-11
      SPIN_PURE                  FALSE
      MAX_UNPAIR                 1
      MO_GUESS_RANDOM_FRAC       0.05
      MO_GUESS_RANDOM_SEED       30304
      STATE_BY_STATE             TRUE
      PRE_ORTHOGONALIZE_STATES   FALSE
      NUMERICAL_GRADIENT         FALSE
      NUMERICAL_GRADIENT_DX      1E-6
      ENERGY_COMPONENT           TRUE
      INTRASTATE_COMPONENT       TRUE
      INTERSTATE_COMPONENT       TRUE

      &TIDFT_OPTIMIZER_PCG
        PRECONDITIONER             QHQ_S
        PREC_WEIGHT_OVERLAP        0.85
        EPS_ERROR                  1.0E-6
        WHICH_GRADIENT_NORM         RMS
        MAX_ITER                   50
        MAX_ITER_OUTER_LOOP        30 !20
        LIN_SEARCH_EPS_ERROR       0.2
        LIN_SEARCH_STEP_SIZE_GUESS 0.05
        CONJUGATOR                 FLETCHER
      &END TIDFT_OPTIMIZER_PCG

      &PENALTY
        INTRASTATE_NON_PENALTY_STRENGTH    1E-5
        INTERSTATE_NON_PENALTY_STRENGTH    1 !0.01
        PENALTY_STRENGTH_INCREASE_FACTOR   2.0
        MAX_NORM_PHI_OFF_DIAG              5.0E-3
        !ALLOWED_DETERMINANT_DEVIATION      1E-4
        MAX_CP_STEP                        1
        LOOSE_EPS_SCF                     1E-2
      &END PENALTY

      &WF_GUESS
        MAX_EXC_ENERGY    800
        MIN_EXC_ENERGY    0.00
        MAX_EXC_ORDER     2 !10
        EXCITE_ALPHA_ONLY T 
      &END WF_GUESS

    &END TIDFT

    &SCF
      SCF_GUESS ATOMIC
      EPS_SCF 1.0E-6
      MAX_SCF 50
      &OT ON
        !ALGORITHM IRAC
        !MINIMIZER DIIS
        PRECONDITIONER FULL_SINGLE_INVERSE !FULL_ALL
        ROTATION T
      &END OT
      &OUTER_SCF
         EPS_SCF 1.0E-6
         MAX_SCF 20
      &END
      &PRINT
        &RESTART OFF  !ON !
        &END
      &END
    &END SCF
    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &SUBSYS
    &CELL
      ABC  30 30 30 !20 20 20 !15.0 15.0 15.0  
      MULTIPLE_UNIT_CELL 1 1 1 ! RZK: No need to multiply the cell for gas-phase molecules
    &END CELL
    &TOPOLOGY
      MULTIPLE_UNIT_CELL 1 1 1
      &CENTER_COORDINATES T
      &END
    &END
    &COORD  ! optimized coords 
  C        -4.6789061705       -0.4302919360       -0.0000000000
  H        -4.1733938134       -1.4110374046        0.0000000001
  H        -5.7805588529       -0.4324439158        0.0000000001
  C        -3.9632616792        0.7281804569       -0.0000000001
  H        -4.4953403839        1.6973185755       -0.0000000003
  C        -2.5017269194        0.7836580251       -0.0000000001
  H        -1.9710165491       -0.1862061414       -0.0000000002
  C        -1.7836885282        1.9408612574        0.0000000002
  H        -2.2860651186        2.9230590782        0.0000000002
  H        -0.6820492515        1.9387922208        0.0000000004
    !not yet optimized coords
!      C                 -4.67914455   -0.41889482    0.00000000
!      H                 -4.14598080   -1.34659974    0.00000000
!      H                 -5.74914455   -0.41889482    0.00000000
!      C                 -4.00387024    0.75608247    0.00000000
!      H                 -4.53703398    1.68378739    0.00000000
!      C                 -2.46387024    0.75608247    0.00000000
!      H                 -1.93070649   -0.17162245    0.00000000
!      C                 -1.78162684    1.92702696    0.00000000
!      H                 -2.30926931    2.85788324   -0.00000000
!      H                 -0.71164572    1.92066966    0.00000000
    &END COORD
    &KIND C
      BASIS_SET DZVP-GTH
      POTENTIAL GTH-BLYP-q4
    &END KIND
    &KIND H
      BASIS_SET DZVP-GTH
      POTENTIAL GTH-BLYP-q1
    &END KIND
  &END SUBSYS
&END FORCE_EVAL

