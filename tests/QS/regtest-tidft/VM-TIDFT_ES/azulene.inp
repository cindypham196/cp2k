&GLOBAL
  PROJECT naphthalene
  RUN_TYPE ENERGY ! GEO_OPT !
  PRINT_LEVEL LOW
&END GLOBAL

!&MOTION
!  &GEO_OPT
!     OPTIMIZER  LBFGS
!     MAX_ITER  2000
!     MAX_DR     3.000000000000000E-03
!     MAX_FORCE     4.5000000000000000E-04
!     RMS_DR     1.5000000000000000E-03
!     RMS_FORCE    3.00000000000000E-04
!  &END GEO_OPT
! &END MOTION

&FORCE_EVAL
  METHOD QS
!  STRESS_TENSOR  ANALYTICAL

!  &PROPERTIES
!    &TDDFPT
!      NSTATES     30             # number of excited states
!      MAX_ITER    50             # maximum number of Davidson iterations
!      CONVERGENCE [eV] 1.0e-6    # convergence on maximum energy change between iterations
!      &MGRID
!          CUTOFF 300              # separate cutoff for TDDFPT calc
!      &END
!    &END TDDFPT
!  &END PROPERTIES


  &DFT
    POTENTIAL_FILE_NAME             GTH_POTENTIALS
    BASIS_SET_FILE_NAME             GTH_BASIS_SETS
    MULTIPLICITY                    1
    ROKS                            TRUE
    !UKS                             TRUE
    &QS
      TIDFT                         T
      EPS_DEFAULT                   1.0E-12
    &END QS

    &TIDFT
      N_EXCITED_STATES           10 !20
      SUGGESTED_MO_BLOCK_SIZE    5
      EPS_FILTER                 1.0E-11
      SPIN_PURE                  FALSE
      MAX_UNPAIR                 1
      MO_GUESS_RANDOM_FRAC       0.05
      MO_GUESS_RANDOM_SEED       30304
      STATE_BY_STATE             TRUE
      PRE_ORTHOGONALIZE_STATES   FALSE
      NUMERICAL_GRADIENT         FALSE
      NUMERICAL_GRADIENT_DX      1E-6
      ENERGY_COMPONENT           TRUE
      INTRASTATE_COMPONENT       TRUE
      INTERSTATE_COMPONENT       TRUE
      
      &TIDFT_OPTIMIZER_PCG
        PRECONDITIONER             QHQ_S
        PREC_WEIGHT_OVERLAP       0.85
        EPS_ERROR                  1.0E-6
        WHICH_GRADIENT_NORM        RMS
        MAX_ITER                   50
        MAX_ITER_OUTER_LOOP        20
        LIN_SEARCH_EPS_ERROR       0.2
        LIN_SEARCH_STEP_SIZE_GUESS 0.05
        CONJUGATOR                 FLETCHER
      &END TIDFT_OPTIMIZER_PCG

      &PENALTY
        INTRASTATE_NON_PENALTY_STRENGTH    1E-5
        INTERSTATE_NON_PENALTY_STRENGTH    1
        PENALTY_STRENGTH_INCREASE_FACTOR   2.0
        MAX_NORM_PHI_OFF_DIAG              5.0E-3
        MAX_CP_STEP                        4 !3
        LOOSE_EPS_SCF                     1E-2
      &END PENALTY

      &WF_GUESS
        MAX_EXC_ENERGY    800
        MIN_EXC_ENERGY    0.00
        MAX_EXC_ORDER     2 
        EXCITE_ALPHA_ONLY T 
      &END WF_GUESS

    &END TIDFT

    &SCF
      SCF_GUESS ATOMIC
      EPS_SCF 1.0E-6
      MAX_SCF 50 !30
      &OT ON
        !ALGORITHM IRAC
        !MINIMIZER DIIS
        PRECONDITIONER FULL_SINGLE_INVERSE !FULL_ALL
        ROTATION T
      &END OT
      &OUTER_SCF
         EPS_SCF 1.0E-6
         MAX_SCF 20 !100 !5
      &END
      &PRINT
        &RESTART OFF  !ON !
        &END
      &END
    &END SCF

    &POISSON
      PERIODIC NONE
      PSOLVER  WAVELET !MULTIPOLE !
    &END POISSON

    &MGRID
      CUTOFF 300
      NGRIDS 5
    &END MGRID

    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &SUBSYS
    &CELL
      ABC  20 20 20 !15.0 15.0 15.0 !30.0 30.0 30.0 
      MULTIPLE_UNIT_CELL 1 1 1 ! RZK: No need to multiply the cell for gas-phase molecules
      PERIODIC NONE
    &END CELL
    &TOPOLOGY
      MULTIPLE_UNIT_CELL 1 1 1
      &CENTER_COORDINATES T
      &END
    &END
    &COORD !ZHENZHE optimized structure 
 C                  0.00000000   -0.92693300    0.00000000
 C                 -0.84112200   -2.04676100    0.00000000
 C                 -2.16687300   -1.60250800    0.00000000
 C                 -2.20377700   -0.20428600    0.00000000
 C                 -0.88662100    0.27171800    0.00000000
 C                  1.38697700   -0.95100000    0.00000000
 C                  2.27969100    0.11626300    0.00000000
 C                  2.00226600    1.48020800    0.00000000
 C                 -0.50268600    1.60488000    0.00000000
 C                  0.77907600    2.14538200    0.00000000
 H                  0.83372400    3.22958100    0.00000000
 H                 -1.32030100    2.32270200    0.00000000
 H                 -3.09046300    0.41439100    0.00000000
 H                 -3.03720100   -2.24657500    0.00000000
 H                 -0.50906700   -3.07582300    0.00000000
 H                  1.83323800   -1.94339100    0.00000000
 H                  3.33238400   -0.14956300    0.00000000
 H                  2.87610700    2.12689400    0.00000000
    &END COORD
    &KIND C
      BASIS_SET DZVP-GTH
      POTENTIAL GTH-BLYP-q4
    &END KIND
    &KIND H
      BASIS_SET DZVP-GTH
      POTENTIAL GTH-BLYP-q1
    &END KIND
  &END SUBSYS
&END FORCE_EVAL

