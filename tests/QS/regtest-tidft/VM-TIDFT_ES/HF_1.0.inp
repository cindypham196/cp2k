&GLOBAL
  PROJECT HF
  RUN_TYPE ENERGY
  PRINT_LEVEL MEDIUM
&END GLOBAL
&FORCE_EVAL
  METHOD QS
! STRESS_TENSOR  ANALYTICAL

!  &PROPERTIES
!    &TDDFPT
!      NSTATES    10             # number of excited states
!      MAX_ITER    50             # maximum number of Davidson iterations
!      CONVERGENCE [eV] 1.0e-6    # convergence on maximum energy change between iterations
!      &MGRID
!          CUTOFF 300              # separate cutoff for TDDFPT calc
!      &END
!    &END TDDFPT
!  &END PROPERTIES

  &DFT
    POTENTIAL_FILE_NAME GTH_POTENTIALS
    BASIS_SET_FILE_NAME GTH_BASIS_SETS
    MULTIPLICITY        1
    !ROKS                T
    UKS                  T
    &QS
      TIDFT T
      EPS_DEFAULT 1.0E-12
    &END QS

   &TIDFT
      N_EXCITED_STATES              10 !20
      SUGGESTED_MO_BLOCK_SIZE       3
      EPS_FILTER                    1.0E-10
      SPIN_PURE                     F
      MAX_UNPAIR                    1
      MO_GUESS_RANDOM_FRAC          0.1
      MO_GUESS_RANDOM_SEED          301
      STATE_BY_STATE                TRUE
      PRE_ORTHOGONALIZE_STATES      FALSE
      NUMERICAL_GRADIENT            FALSE
      NUMERICAL_GRADIENT_DX         1E-9
      ENERGY_COMPONENT              TRUE
      INTRASTATE_COMPONENT          TRUE
      INTERSTATE_COMPONENT          TRUE

      &TIDFT_OPTIMIZER_PCG
        PRECONDITIONER              QHQ_S
        PREC_WEIGHT_OVERLAP         0.85
        EPS_ERROR                   1.0E-6
        WHICH_GRADIENT_NORM         RMS
        MAX_ITER                    50
        MAX_ITER_OUTER_LOOP         100 !20
        LIN_SEARCH_EPS_ERROR        0.5
        LIN_SEARCH_STEP_SIZE_GUESS  0.01
        CONJUGATOR                  FLETCHER
      &END TIDFT_OPTIMIZER_PCG

      &PENALTY
        INTRASTATE_NON_PENALTY_STRENGTH    1.0E-5
        INTERSTATE_NON_PENALTY_STRENGTH    1.0
        PENALTY_STRENGTH_INCREASE_FACTOR   2 !1.414213562373095
        MAX_NORM_PHI_OFF_DIAG              5.0E-3
        MAX_CP_STEP                        1
        LOOSE_EPS_SCF                      1.0E-3
      &END PENALTY

      &WF_GUESS
        MAX_EXC_ENERGY   200.0
        MIN_EXC_ENERGY   0.0
        MAX_EXC_ORDER    2 
        EXCITE_ALPHA_ONLY T 
      &END WF_GUESS

    &END TIDFT
    &MGRID
      CUTOFF 300
      NGRIDS 5
    &END MGRID
    &XC
      &XC_FUNCTIONAL PBE !BLYP
      &END XC_FUNCTIONAL
    &END XC

    &SCF
      SCF_GUESS ATOMIC
      EPS_SCF 1.0E-6
      MAX_SCF 50
      &OT ON
        !ALGORITHM IRAC
        !MINIMIZER DIIS
        PRECONDITIONER FULL_SINGLE !FULL_ALL
        ROTATION T
      &END OT
      &PRINT
        &RESTART OFF
        &END
      &END
      &OUTER_SCF
         EPS_SCF 1.0E-6
         MAX_SCF 100 !5
      &END
    &END SCF

    &POISSON
      PERIODIC NONE
      PSOLVER  WAVELET
    &END POISSON

  &END DFT
  &SUBSYS
    &CELL
      ABC 20 20 20 !4.0351 4.0351 15 !4.0351
      MULTIPLE_UNIT_CELL 1 1 1 
      PERIODIC NONE
    &END CELL
    &TOPOLOGY
      MULTIPLE_UNIT_CELL 1 1 1
      &CENTER_COORDINATES T
      &END
    &END
    &COORD
    H  0.0     0.0     0.0
    F   0.0     0.0     1.0

    &END COORD
    &KIND H
      BASIS_SET DZVP-GTH 
      POTENTIAL GTH-BLYP-q1
    &END KIND
    &KIND F
      BASIS_SET DZVP-GTH
      POTENTIAL GTH-BLYP-q7
    &END KIND
  &END SUBSYS
&END FORCE_EVAL

