&GLOBAL
  PROJECT NH3-F2
  RUN_TYPE ENERGY  !GEO_OPT !
!  TRACE TRUE
!  TRACE_ROUTINES 
  PRINT_LEVEL MEDIUM !LOW
&END GLOBAL

!&MOTION
!  &GEO_OPT
!     OPTIMIZER  LBFGS
!     MAX_ITER  2000
!     MAX_DR     3.000000000000000E-03
!     MAX_FORCE     4.5000000000000000E-04
!     RMS_DR     1.5000000000000000E-03
!     RMS_FORCE    3.00000000000000E-04
!  &END GEO_OPT
!  
!  &CONSTRAINT
!    &FIXED_ATOMS
!      !COMPONENTS_TO_FIX X
!      LIST 1 2 3
!    &END
!  &END
!
! &END MOTION

&FORCE_EVAL
  METHOD QS
!  STRESS_TENSOR  ANALYTICAL

!  &PROPERTIES
!    &TDDFPT
!      NSTATES     10             # number of excited states
!      MAX_ITER    50             # maximum number of Davidson iterations
!      CONVERGENCE [eV] 1.0e-6    # convergence on maximum energy change between iterations
!      &MGRID
!          CUTOFF 300              # separate cutoff for TDDFPT calc
!      &END
!    &END TDDFPT
!  &END PROPERTIES

  &DFT
    BASIS_SET_FILE_NAME BASIS_MOLOPT 
    POTENTIAL_FILE_NAME POTENTIAL


    UKS                 T    ! == LSD?  RZK: UKS - compare to OT.
    !ROKS                T   ! RZK: Also, perform ROKS with TIDFT (same multiplicities)

    &MGRID
      CUTOFF 300
      NGRIDS 4
    &END MGRID

    &QS
      TIDFT  T
      EPS_DEFAULT 1.0E-11
    &END QS

    &TIDFT
      N_EXCITED_STATES           10
      SUGGESTED_MO_BLOCK_SIZE    4
      EPS_FILTER                 1.0E-8
      SPIN_PURE                  FALSE
      MAX_UNPAIR                 1
      MO_GUESS_RANDOM_FRAC       0.05
      MO_GUESS_RANDOM_SEED       30304
      STATE_BY_STATE             TRUE
      PRE_ORTHOGONALIZE_STATES   FALSE
      NUMERICAL_GRADIENT         FALSE
      NUMERICAL_GRADIENT_DX      1E-6
      ENERGY_COMPONENT           TRUE
      INTRASTATE_COMPONENT       TRUE
      INTERSTATE_COMPONENT       TRUE

      &TIDFT_OPTIMIZER_PCG
        PRECONDITIONER             QHQ_S
        PREC_WEIGHT_OVERLAP       0.85
        EPS_ERROR                  1.0E-6
        WHICH_GRADIENT_NORM        RMS
        MAX_ITER                   150
        MAX_ITER_OUTER_LOOP        200
        LIN_SEARCH_EPS_ERROR       0.2
        LIN_SEARCH_STEP_SIZE_GUESS 0.05
        CONJUGATOR                 FLETCHER
      &END TIDFT_OPTIMIZER_PCG

      &PENALTY
        INTRASTATE_NON_PENALTY_STRENGTH    1.0E-5
        INTERSTATE_NON_PENALTY_STRENGTH    10
        PENALTY_STRENGTH_INCREASE_FACTOR   2.0
        MAX_NORM_PHI_OFF_DIAG              5.0E-3
        MAX_CP_STEP                         1 !4
        LOOSE_EPS_SCF                     1E-2
      &END PENALTY

      &WF_GUESS
        MAX_EXC_ENERGY    1000.00
        MIN_EXC_ENERGY    0.00
        MAX_EXC_ORDER     2
        EXCITE_ALPHA_ONLY T 
      &END WF_GUESS

    &END TIDFT

    &SCF
      SCF_GUESS ATOMIC
      EPS_SCF 1.0E-6
      MAX_SCF 50
      &OT ON
        !ALGORITHM IRAC
        !MINIMIZER DIIS
        PRECONDITIONER FULL_SINGLE_INVERSE !FULL_ALL
        ROTATION T
      &END OT
      &OUTER_SCF
         EPS_SCF 1.0E-6
         MAX_SCF 20
      &END
      &PRINT
        &RESTART OFF !ON
        &END
      &END
    &END SCF

    &POISSON
      PERIODIC NONE
      PSOLVER  WAVELET !MULTIPOLE !
    &END POISSON

    &XC
      &XC_FUNCTIONAL PBE !BLYP
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &SUBSYS
    &CELL
      ABC 20 20 20 !10 10 10 !40.0 8.0 8.0 !25.0  8.0  8.0 ! 
      MULTIPLE_UNIT_CELL 1 1 1
      PERIODIC NONE
    &END CELL
    &TOPOLOGY
      MULTIPLE_UNIT_CELL 1 1 1
      &CENTER_COORDINATES T
      &END
    &END
    &COORD  !shift to origin, opted, initial distance
  N         3.5900000000        0.0000000000        0.0000000000
  F         1.650000000         0.0000000000        0.0000000000
  F         -0.000000000        0.0000000000        0.0000000000
  H         3.8726568788        0.9787391353       -0.0504190804
  H         3.8784894711       -0.5370440205       -0.8175448806
  H         3.8587854175       -0.4432509484        0.8782282506
! optmized coords
!  N         4.5166651519        2.9695320067        3.0252878005
!  H         4.7418026075        1.9752380488        3.0491281555
!  H         4.7440622515        3.4430639732        3.8992700485
!  H         4.9076349780        3.4419186402        2.2091203590
!  F         2.5812271564        3.0202794504        2.9333254594   
!  F         0.9306981369        2.9828493069        2.8848207046
    &END COORD
    &KIND F
      BASIS_SET DZVP-MOLOPT-SR-GTH
      POTENTIAL GTH-BLYP-q7
    &END KIND
    &KIND N
      BASIS_SET DZVP-MOLOPT-GTH
      POTENTIAL GTH-BLYP-q5
    &END KIND
    &KIND H
      BASIS_SET DZVP-MOLOPT-GTH
      POTENTIAL GTH-BLYP-q1
    &END KIND
  &END SUBSYS
&END FORCE_EVAL

