&GLOBAL
  PROJECT naphthalene
  RUN_TYPE ENERGY ! GEO_OPT !
  PRINT_LEVEL LOW
&END GLOBAL

!&MOTION
!  &GEO_OPT
!     OPTIMIZER  LBFGS
!     MAX_ITER  2000
!     MAX_DR     3.000000000000000E-03
!     MAX_FORCE     4.5000000000000000E-04
!     RMS_DR     1.5000000000000000E-03
!     RMS_FORCE    3.00000000000000E-04
!  &END GEO_OPT
! &END MOTION

&FORCE_EVAL
  METHOD QS
!  STRESS_TENSOR  ANALYTICAL

!  &PROPERTIES
!    &TDDFPT
!      NSTATES     30             # number of excited states
!      MAX_ITER    50             # maximum number of Davidson iterations
!      CONVERGENCE [eV] 1.0e-6    # convergence on maximum energy change between iterations
!      &MGRID
!          CUTOFF 300              # separate cutoff for TDDFPT calc
!      &END
!    &END TDDFPT
!  &END PROPERTIES

  &DFT
    POTENTIAL_FILE_NAME             GTH_POTENTIALS
    BASIS_SET_FILE_NAME             GTH_BASIS_SETS
    MULTIPLICITY                    1
    ROKS                            TRUE
    !UKS                             TRUE
    &QS
      TIDFT                         T !F
      EPS_DEFAULT                   1.0E-12
    &END QS

    &TIDFT
      N_EXCITED_STATES           10 !5 !20
      SUGGESTED_MO_BLOCK_SIZE    5
      EPS_FILTER                 1.0E-11
      SPIN_PURE                  FALSE
      MAX_UNPAIR                 1
      MO_GUESS_RANDOM_FRAC       0.05
      MO_GUESS_RANDOM_SEED       30304
      STATE_BY_STATE             TRUE
      PRE_ORTHOGONALIZE_STATES   FALSE
      NUMERICAL_GRADIENT         FALSE
      NUMERICAL_GRADIENT_DX      1E-6
      ENERGY_COMPONENT           TRUE
      INTRASTATE_COMPONENT       TRUE
      INTERSTATE_COMPONENT       TRUE

      &TIDFT_OPTIMIZER_PCG
        PRECONDITIONER             QHQ_S
        PREC_WEIGHT_OVERLAP         0.85
        EPS_ERROR                  1.0E-6
        WHICH_GRADIENT_NORM        RMS
        MAX_ITER                   50
        MAX_ITER_OUTER_LOOP        100 !20
        LIN_SEARCH_EPS_ERROR       0.2
        LIN_SEARCH_STEP_SIZE_GUESS 0.05
        CONJUGATOR                 FLETCHER
      &END TIDFT_OPTIMIZER_PCG

      &PENALTY
        INTRASTATE_NON_PENALTY_STRENGTH    1E-5
        INTERSTATE_NON_PENALTY_STRENGTH    10 !0.01
        PENALTY_STRENGTH_INCREASE_FACTOR   2.0
        MAX_NORM_PHI_OFF_DIAG              5.0E-3
        !ALLOWED_DETERMINANT_DEVIATION      1E-4
        MAX_CP_STEP                        4 !3
        LOOSE_EPS_SCF                     1E-2
      &END PENALTY

      &WF_GUESS
        MAX_EXC_ENERGY    800
        MIN_EXC_ENERGY    0.00
        MAX_EXC_ORDER     2 !10
        EXCITE_ALPHA_ONLY T
      &END WF_GUESS

    &END TIDFT

    &SCF
      SCF_GUESS ATOMIC
      EPS_SCF 1.0E-6
      MAX_SCF 100 !50 !30
      &OT ON
        !ALGORITHM IRAC
        !MINIMIZER DIIS
        PRECONDITIONER FULL_SINGLE_INVERSE !FULL_ALL
        ROTATION T
      &END OT
      &OUTER_SCF
         EPS_SCF 1.0E-6
         MAX_SCF 50 !20 !100 !5
      &END
      &PRINT
        &RESTART OFF  !ON !
        &END
      &END
    &END SCF

    &POISSON
      PERIODIC NONE
      PSOLVER  WAVELET !MULTIPOLE !
    &END POISSON

    &MGRID
      CUTOFF 300
      NGRIDS 5
    &END MGRID

    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &SUBSYS
    &CELL
      ABC  20 20 20 ! 15 15 15 ! 30.0 30.0 30.0 !
      MULTIPLE_UNIT_CELL 1 1 1 ! RZK: No need to multiply the cell for gas-phase molecules
      PERIODIC NONE
    &END CELL
    &TOPOLOGY
      MULTIPLE_UNIT_CELL 1 1 1
      &CENTER_COORDINATES T
      &END
    &END
    &COORD
    ! CINDY optimized coords 
  C        -6.2846805625       -0.5568568513        0.0002419046
  C        -4.8911345550       -0.5533978695        0.0001596019
  C        -4.1587781408        0.6769747822        0.0002378989
  C        -4.8899897807        1.9256714803        0.0004615375
  C        -6.3210285094        1.8886249013        0.0006190982
  C        -7.0060362117        0.6750836953        0.0004740819
  H        -2.1730805666       -0.2378745050       -0.0000839207
  H        -6.8334132082       -1.5114370872        0.0001751050
  H        -4.3308075079       -1.5018263114        0.0000134689
  C        -2.7269988171        0.7144350159        0.0000706731
  C        -4.1582272515        3.1561032659        0.0005567184
  H        -6.8741451562        2.8412692280        0.0008963759
  H        -8.1070699643        0.6638332997        0.0005899805
  C        -2.7647575904        3.1595828305        0.0003068692
  C        -2.0426296392        1.9281133258        0.0000489327
  H        -4.7170967894        4.1052624162        0.0009496400
  H        -2.2151922823        4.1138630327        0.0003643875
  H        -0.9413662072        1.9401007806       -0.0001650385    
    &END COORD
    &KIND C
      BASIS_SET DZVP-GTH
      POTENTIAL GTH-BLYP-q4
    &END KIND
    &KIND H
      BASIS_SET DZVP-GTH
      POTENTIAL GTH-BLYP-q1
    &END KIND
  &END SUBSYS
&END FORCE_EVAL

