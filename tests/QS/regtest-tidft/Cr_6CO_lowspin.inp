&GLOBAL
  PROJECT Cr(Cl)6
  RUN_TYPE ENERGY
  PRINT_LEVEL LOW
&END GLOBAL
&FORCE_EVAL
  METHOD QS
  &DFT
    BASIS_SET_FILE_NAME BASIS_MOLOPT_COMBINED  !GTH_BASIS_SETS
    POTENTIAL_FILE_NAME POTENTIAL
    &MGRID
      CUTOFF 300
      NGRIDS 4
    &END MGRID
    !UKS                  F
    ROKS                T
    &QS
      TIDFT T
      EPS_DEFAULT 1.0E-12
    &END QS

    &TIDFT
      N_EXCITED_STATES           0
      SUGGESTED_MO_BLOCK_SIZE    34
      EPS_FILTER                 1.0E-11
      SPIN_PURE                  FALSE
      MAX_UNPAIR                 0
      MO_GUESS_RANDOM_FRAC       0.05
      MO_GUESS_RANDOM_SEED       30304
      STATE_BY_STATE             TRUE
      PRE_ORTHOGONALIZE_STATES   FALSE
      NUMERICAL_GRADIENT         FALSE
      NUMERICAL_GRADIENT_DX      1E-6
      ENERGY_COMPONENT           TRUE
      INTRASTATE_COMPONENT       TRUE
      INTERSTATE_COMPONENT       TRUE

      &TIDFT_OPTIMIZER_PCG
        PRECONDITIONER             QHQ_S
        EPS_ERROR                  1.0E-8
        MAX_ITER                   50
        MAX_ITER_OUTER_LOOP        100
        LIN_SEARCH_EPS_ERROR       0.2
        LIN_SEARCH_STEP_SIZE_GUESS 0.05
        CONJUGATOR                 FLETCHER
      &END TIDFT_OPTIMIZER_PCG

      &PENALTY
        INTRASTATE_NON_PENALTY_STRENGTH    1E-5
        INTERSTATE_NON_PENALTY_STRENGTH    1
        PENALTY_STRENGTH_INCREASE_FACTOR   2.0
        ALLOWED_DETERMINANT_DEVIATION      1E-4
        CP_STEP                             3
        TIGHTEN_EPS_SCF                     1E-2
      &END PENALTY

    &END TIDFT

    &SCF
      SCF_GUESS ATOMIC
      EPS_SCF 1.0E-7
      MAX_SCF 30
      &OT ON
        !ALGORITHM IRAC
        !MINIMIZER DIIS
        PRECONDITIONER FULL_ALL
      &END OT
      &OUTER_SCF
         EPS_SCF 1.0E-7
         MAX_SCF 5
      &END
      &PRINT
        &RESTART OFF
        &END
      &END
    &END SCF
    &XC
      &XC_FUNCTIONAL BLYP
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &SUBSYS
    &CELL
      ABC 11.49  10.905  6.197
      MULTIPLE_UNIT_CELL 1 1 1
    &END CELL
    &TOPOLOGY
      MULTIPLE_UNIT_CELL 1 1 1
    &END
    &COORD
      Cr      1.462792    2.726250    0.381301
      C       2.515735    2.726250    1.976161
      C       0.324937    4.071600    1.119488
      O       3.142975    2.726250    2.920522
      O      -0.362739    4.870391    1.551853
      C       0.426854    2.726250   -1.221553
      O      -0.183036    2.726250   -2.184876
      C       2.585135    1.360508   -0.358806
      O       3.236388    0.540779   -0.801334
      C       0.324937    1.380900    1.119488
      O      -0.362739    0.582109    1.551853
      C       2.585135    4.091992   -0.358806
      O       3.236388    4.911721   -0.801334
    &END COORD
    &KIND Cr
      BASIS_SET TZV2P-MOLOPT-SR-GTH
      POTENTIAL GTH-BLYP-q14
    &END KIND
    &KIND C
      BASIS_SET DZVP-MOLOPT-GTH
      POTENTIAL GTH-BLYP-q4
    &END KIND
    &KIND O
      BASIS_SET DZVP-MOLOPT-GTH
      POTENTIAL GTH-BLYP-q6
    &END KIND
  &END SUBSYS
&END FORCE_EVAL

