&GLOBAL
  PROJECT                           ATOM
  RUN_TYPE                          ENERGY
  PRINT_LEVEL                       MEDIUM
&END GLOBAL

&FORCE_EVAL

  METHOD QS

  !&PROPERTIES
  !  &TDDFPT
  !     NSTATES     10             # number of excited states
  !     MAX_ITER    50             # maximum number of Davidson iterations
  !     CONVERGENCE [eV] 1.0e-6    # convergence on maximum energy change between iterations
  !     &MGRID
  !        CUTOFF 300              # separate cutoff for TDDFPT calc
  !     &END
  !  &END TDDFPT
  !&END PROPERTIES

  &DFT
    POTENTIAL_FILE_NAME             GTH_POTENTIALS
    BASIS_SET_FILE_NAME             GTH_BASIS_SETS
    MULTIPLICITY                    1
    ROKS                            TRUE
    !UKS                             TRUE
    &QS
      TIDFT                         T !F
      EPS_DEFAULT                   1.0E-12
    &END QS

    &TIDFT
      N_EXCITED_STATES              2
      SUGGESTED_MO_BLOCK_SIZE       10
      EPS_FILTER                    1.0E-10
      SPIN_PURE                     F
      MAX_UNPAIR                    1
      MO_GUESS_RANDOM_FRAC          0.1
      MO_GUESS_RANDOM_SEED          301
      STATE_BY_STATE                TRUE
      PRE_ORTHOGONALIZE_STATES      FALSE
      NUMERICAL_GRADIENT            FALSE
      NUMERICAL_GRADIENT_DX         1E-9  !1E-6
      ENERGY_COMPONENT              TRUE
      INTRASTATE_COMPONENT          TRUE
      INTERSTATE_COMPONENT          TRUE

      &TIDFT_OPTIMIZER_PCG
        PRECONDITIONER              QHQ_S
        PREC_WEIGHT_OVERLAP         0.85  !0.65 use 0.85 to avoid precond failure
        EPS_ERROR                   1.0E-6
        MAX_ITER                    50
        MAX_ITER_OUTER_LOOP         150 !20
        LIN_SEARCH_EPS_ERROR        0.5
        LIN_SEARCH_STEP_SIZE_GUESS  0.01
        CONJUGATOR                  FLETCHER
      &END TIDFT_OPTIMIZER_PCG

      &PENALTY
        INTRASTATE_NON_PENALTY_STRENGTH    1.0E-5
        INTERSTATE_NON_PENALTY_STRENGTH    1.0
        PENALTY_STRENGTH_INCREASE_FACTOR   2 !1.414213562373095
        ALLOWED_DETERMINANT_DEVIATION      1.0E-5
        MAX_CP_STEP                        1
        LOOSE_EPS_SCF                      1.0E-3
      &END PENALTY

      &WF_GUESS
      !  EXCITE_ALPHA_ONLY TRUE 
        MAX_EXC_ENERGY   500.0
        MIN_EXC_ENERGY   250.0
        MAX_EXC_ORDER    1
      &END WF_GUESS

      &PRINT
        &NTO_ANALYSIS
          CUBE_FILES T
        &END
      &END PRINT
    &END TIDFT

    &SCF
      SCF_GUESS ATOMIC
      EPS_SCF 1.0E-6 !1.0E-8
      MAX_SCF 30
      &OT ON
        !ALGORITHM IRAC
        !MINIMIZER DIIS
        PRECONDITIONER FULL_SINGLE !FULL_ALL
        ROTATION T
      &END OT
      &OUTER_SCF
         EPS_SCF 1.0E-6 !1.0E-8
         MAX_SCF 5
      &END
      &PRINT
        &RESTART OFF
        &END
      &END
    &END SCF

    &POISSON
      PERIODIC NONE
      PSOLVER  WAVELET
    &END POISSON

    &MGRID
      CUTOFF 300
      NGRIDS 5
    &END MGRID
    &XC
      &XC_FUNCTIONAL BLYP
      &END XC_FUNCTIONAL
      &XC_GRID
        XC_DERIV SPLINE2_SMOOTH      # this is needed for the 2nd derivatives of the XC functional
      &END XC_GRID
    &END XC
  &END DFT
  &SUBSYS
    &CELL
      ABC 8. 8. 8.
      MULTIPLE_UNIT_CELL 1 1 1
      PERIODIC NONE
    &END CELL
    &TOPOLOGY
      &CENTER_COORDINATES
      &END CENTER_COORDINATES
      MULTIPLE_UNIT_CELL 1 1 1
    &END
    &COORD
      He      0.0 0.0 0.0
      !H       0.0 0.0 0.0
    &END COORD
    &KIND H
      BASIS_SET DZVP-GTH !TZVP-GTH !SZV-GTH
      POTENTIAL GTH-BLYP-q1
    &END KIND
    &KIND He
      BASIS_SET QZV3P-GTH !DZVP-GTH !SZV-GTH !TZVP-GTH !
      POTENTIAL GTH-BLYP-q2
      !&BS
      !  &ALPHA
      !     NEL     +1
      !     N        1
      !     L        0
      !  &END ALPHA
      !  &BETA
      !     NEL     -1
      !     N        1
      !     L        0
      !  &END BETA
      !&END BS
    &END KIND
  &END SUBSYS
&END FORCE_EVAL

