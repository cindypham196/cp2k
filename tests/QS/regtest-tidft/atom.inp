&GLOBAL
  PROJECT H2O
  RUN_TYPE ENERGY
  PRINT_LEVEL LOW
&END GLOBAL
&FORCE_EVAL
  METHOD QS
  &DFT
    POTENTIAL_FILE_NAME GTH_POTENTIALS
    BASIS_SET_FILE_NAME GTH_BASIS_SETS
    MULTIPLICITY        1
    ROKS                TRUE
    &QS
      TIDFT T
      EPS_DEFAULT 1.0E-12
    &END QS

    &TIDFT
      N_EXCITED_STATES           2
      SUGGESTED_MO_BLOCK_SIZE    34
      EPS_FILTER                 1.0E-8
      SPIN_PURE                  TRUE
      MAX_UNPAIR                 1
    &END TIDFT

    &MGRID
      CUTOFF 200 ! 320
      NGRIDS 5
    &END MGRID
    &XC
      &XC_FUNCTIONAL BLYP
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &SUBSYS
    &CELL
      ABC 4. 4. 4.
      MULTIPLE_UNIT_CELL 1 1 1
    &END CELL
    &TOPOLOGY
      MULTIPLE_UNIT_CELL 1 1 1
    &END
    &COORD
      He      0.0 0.0 0.0
    !  H       0.0 0.0 0.0
    &END COORD
    &KIND H
      BASIS_SET SZV-GTH
      POTENTIAL GTH-BLYP-q1
    &END KIND
    &KIND He
      BASIS_SET SZV-GTH
      POTENTIAL GTH-BLYP-q2
    &END KIND
  &END SUBSYS
&END FORCE_EVAL

