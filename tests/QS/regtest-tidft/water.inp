&GLOBAL
  PROJECT H2O
  RUN_TYPE ENERGY
  PRINT_LEVEL LOW
&END GLOBAL
&FORCE_EVAL

  METHOD QS

  !&PROPERTIES
  !  &TDDFPT
  !     NSTATES      3             # number of excited states
  !     MAX_ITER    50             # maximum number of Davidson iterations
  !     CONVERGENCE [eV] 1.0e-3    # convergence on maximum energy change between iterations
  !     &MGRID
  !        CUTOFF 200              # separate cutoff for TDDFPT calc
  !     &END
  !  &END TDDFPT
  !&END PROPERTIES

  &DFT
    POTENTIAL_FILE_NAME GTH_POTENTIALS
    BASIS_SET_FILE_NAME GTH_BASIS_SETS
    MULTIPLICITY        1
    ROKS                TRUE
    &QS
      TIDFT T
      EPS_DEFAULT 1.0E-12
    &END QS

    &TIDFT
      N_EXCITED_STATES           3
      SUGGESTED_MO_BLOCK_SIZE    34
      EPS_FILTER                 1.0E-11
      SPIN_PURE                  FALSE
      MAX_UNPAIR                 1
      INITIAL_GUESS_RANDOM_FRAC  0.05
      STATE_BY_STATE             TRUE
      NUMERICAL_GRADIENT         FALSE
      NUMERICAL_GRADIENT_DX      1E-6
      ENERGY_COMPONENT           TRUE
      INTRASTATE_COMPONENT       TRUE
      INTERSTATE_COMPONENT       TRUE
      
      &TIDFT_OPTIMIZER_PCG
        EPS_ERROR                  1.0E-5
        MAX_ITER                   100
        MAX_ITER_OUTER_LOOP        4
        LIN_SEARCH_EPS_ERROR       0.1
        LIN_SEARCH_STEP_SIZE_GUESS 0.1
        CONJUGATOR                 FLETCHER
      &END TIDFT_OPTIMIZER_PCG

      &PENALTY
        INTRASTATE_NON_PENALTY_STRENGTH    1.
        INTERSTATE_NON_PENALTY_STRENGTH    1.
        PENALTY_STRENGTH_INCREASE_FACTOR   2.0
        ALLOWED_DETERMINANT_DEVIATION      0.0001
      &END PENALTY

    &END TIDFT

    &MGRID
      CUTOFF 200 ! 320
      NGRIDS 5
    &END MGRID
    &SCF
      MAX_SCF   50
      EPS_SCF   1e-7
      SCF_GUESS ATOMIC
    &END SCF
    &XC
      &XC_FUNCTIONAL BLYP
      &END XC_FUNCTIONAL
      &XC_GRID
        XC_DERIV SPLINE2_SMOOTH      # this is needed for the 2nd derivatives of the XC functional
      &END XC_GRID
    &END XC
  &END DFT
  &SUBSYS
    &CELL
      ABC 4.5198722000    7.8286483000    7.3588725000
      MULTIPLE_UNIT_CELL 1 1 1
    &END CELL
    &TOPOLOGY
      MULTIPLE_UNIT_CELL 1 1 1
    &END
    &COORD
      O    2.2599361000    1.3047749776    0.9198590625 H2O
      H    3.0132482840    0.8698497241    0.6132391297 H2O
      H    2.2599361000    1.3047749776    1.8397181250 H2O
    &END COORD
    &KIND H
      BASIS_SET SZV-GTH
      POTENTIAL GTH-BLYP-q1
    &END KIND
    &KIND O
      BASIS_SET SZV-GTH
      POTENTIAL GTH-BLYP-q6
    &END KIND
  &END SUBSYS
&END FORCE_EVAL


