&GLOBAL
  PROJECT Al
  RUN_TYPE ENERGY
  PRINT_LEVEL LOW
  EXTENDED_FFT_LENGTHS TRUE
&END GLOBAL

&FORCE_EVAL

  METHOD QS

  &DFT

    BASIS_SET_FILE_NAME BASIS_MOLOPT
    POTENTIAL_FILE_NAME POTENTIAL

    CHARGE              0
    MULTIPLICITY        1
    UKS                 F
    !ROKS                T

    &QS
      TIDFT                      T      ! RZK: main switch between TIDFT code and OT
      EPS_DEFAULT                1.0E-11
    &END QS

    &TIDFT
      N_EXCITED_STATES           0
      SUGGESTED_MO_BLOCK_SIZE    8           
      EPS_FILTER                 1.0E-10   
      SPIN_PURE                  FALSE
      MAX_UNPAIR                 0
      MO_GUESS                   ATOMIC
      MO_GUESS_RANDOM_FRAC       0.05
      MO_GUESS_RANDOM_SEED       30304
      STATE_BY_STATE             TRUE
      PRE_ORTHOGONALIZE_STATES   FALSE
      NUMERICAL_GRADIENT         FALSE
      NUMERICAL_GRADIENT_DX      1E-6
      ENERGY_COMPONENT           TRUE
      INTRASTATE_COMPONENT       TRUE
      INTERSTATE_COMPONENT       FALSE

      &TIDFT_OPTIMIZER_PCG
        PRECONDITIONER             QHQ_S
        EPS_ERROR                  1.0E-8
        WHICH_GRADIENT_NORM        MAX
        MAX_ITER                   50
        MAX_ITER_OUTER_LOOP        100 ! 20
        LIN_SEARCH_EPS_ERROR       0.2
        LIN_SEARCH_STEP_SIZE_GUESS 0.05
        CONJUGATOR                 FLETCHER
      &END TIDFT_OPTIMIZER_PCG

      &PENALTY
        INTRASTATE_NON_PENALTY_STRENGTH    1E-5   ! RZK: establish optimal value
        INTERSTATE_NON_PENALTY_STRENGTH    0.
        PENALTY_STRENGTH_INCREASE_FACTOR   2.0
        ALLOWED_DETERMINANT_DEVIATION      1E-4
      &END PENALTY

    &END TIDFT

    &SCF
      EPS_SCF 1.0E-7     ! RZK: OT code must use absolute max norm, not rms norm
      MAX_SCF 50
      SCF_GUESS ATOMIC
      &OUTER_SCF
        EPS_SCF 1.0E-7
        MAX_SCF 20
      &END OUTER_SCF
      &OT ON
        !ALGORITHM IRAC
        PRECONDITIONER FULL_SINGLE
        ENERGY_GAP   -1.0
        MINIMIZER CG ! DIIS
      &END OT
      &PRINT
        &RESTART OFF
        &END
      &END
    &END SCF

      &MGRID
      CUTOFF 300
      NGRIDS 5
      REL_CUTOFF 50
    &END MGRID

    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
    &END XC
    !&KPOINTS
     !SCHEME MONKHORST-PACK 1 1 1 !12 12 12             
    !&END KPOINTS

  &END DFT

  &SUBSYS

    &CELL
      ABC 4.0495 4.0495 4.0495
      MULTIPLE_UNIT_CELL N N N ! RZK: Find proper N (either in the literature or by computing energy/atom with N=1,2,4,8,16)
    &END CELL

    &TOPOLOGY
      MULTIPLE_UNIT_CELL N N N ! Use the same N
    &END

    &COORD
      SCALED T
      Al 0.0 0.0 0.0
      Al 0.0 0.5 0.5
      Al 0.5 0.0 0.5
      Al 0.5 0.5 0.0
    &END COORD

    &KIND Al
      BASIS_SET DZVP-MOLOPT-SR-GTH
      POTENTIAL GTH-PBE-q3
    &END KIND

  &END SUBSYS

&END FORCE_EVAL

