&GLOBAL
  PROJECT Fe(H2O)6
  RUN_TYPE ENERGY
  PRINT_LEVEL LOW
&END GLOBAL
&FORCE_EVAL
  METHOD QS
  &DFT
    BASIS_SET_FILE_NAME BASIS_MOLOPT
    POTENTIAL_FILE_NAME POTENTIAL
    CHARGE 2
    !LSD
    &MGRID
      CUTOFF 300
      NGRIDS 4
    &END MGRID
    !UKS                  F
    ROKS                T
    &QS
      TIDFT T  !F
      EPS_DEFAULT 1.0E-12
    &END QS

    &TIDFT
      N_EXCITED_STATES           0
      SUGGESTED_MO_BLOCK_SIZE    34
      EPS_FILTER                 1.0E-11
      SPIN_PURE                  FALSE
      MAX_UNPAIR                 4
      MO_GUESS_RANDOM_FRAC       0.05
      MO_GUESS_RANDOM_SEED       30304
      STATE_BY_STATE             TRUE
      PRE_ORTHOGONALIZE_STATES   FALSE
      NUMERICAL_GRADIENT         FALSE
      NUMERICAL_GRADIENT_DX      1E-6
      ENERGY_COMPONENT           TRUE
      INTRASTATE_COMPONENT       TRUE
      INTERSTATE_COMPONENT       TRUE

      &TIDFT_OPTIMIZER_PCG
        PRECONDITIONER             QHQ_S
        EPS_ERROR                  1.0E-8
        MAX_ITER                   50
        MAX_ITER_OUTER_LOOP        100
        LIN_SEARCH_EPS_ERROR       0.2
        LIN_SEARCH_STEP_SIZE_GUESS 0.05
        CONJUGATOR                 FLETCHER
      &END TIDFT_OPTIMIZER_PCG

      &PENALTY
        INTRASTATE_NON_PENALTY_STRENGTH    1E-5
        INTERSTATE_NON_PENALTY_STRENGTH    1
        PENALTY_STRENGTH_INCREASE_FACTOR   2.0
        ALLOWED_DETERMINANT_DEVIATION      1E-4
        MAX_CP_STEP                          3
        LOOSE_EPS_SCF                     1E-2
      &END PENALTY

    &END TIDFT

    &SCF
      SCF_GUESS ATOMIC
      EPS_SCF 1.0E-7
      MAX_SCF 30
      &OT ON
        !ALGORITHM IRAC
        !MINIMIZER DIIS
        PRECONDITIONER  FULL_SINGLE_INVERSE !FULL_ALL is not compatible with ROTATION
        ROTATION T ! Restricted calculation with OT requires orbital rotation
      &END OT
      &OUTER_SCF
         EPS_SCF 1.0E-7
         MAX_SCF 5
      &END
      &PRINT
        &RESTART OFF
        &END
      &END
    &END SCF
    &XC
      &XC_FUNCTIONAL BLYP ! change to HSE
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &SUBSYS
    &CELL
      ABC 8.8 8.8 8.8   !6.4  6.4  6.4
      MULTIPLE_UNIT_CELL 1 1 1
    &END CELL
    &TOPOLOGY
      MULTIPLE_UNIT_CELL 1 1 1
    &END
    &COORD
         Fe                 2.01160109    2.00870261    1.98010463
          O                  2.01160109    0.18870261    1.98010463
          H                  1.41210397   -0.29041562    1.40430836
          O                  3.83160109    2.00870261    1.98010463
          H                  4.15160109    2.78019994    2.45338242
          O                  2.01160109    2.00870261    0.16010463
          H                  2.00394560    2.91376691   -0.15989537
          O                  2.01160109    3.82870261    1.98010463
          H                  1.52617840    4.14870261    2.74401877
          O                  2.01160109    2.00870261    3.80010463
          H                  1.12113684    1.84661186    4.12010463
          H                  2.91588149    4.14870261    2.01853594
          H                  2.59720793    1.31858332    4.12010463
          H                  4.15160109    1.21308335    2.41160202
          H                  1.23162016    1.54954061   -0.15989537
          H                  2.60704046   -0.29017396    2.55978209
          O                  0.19160109    2.00870261    1.98010463
          H                 -0.28839891    2.68977195    1.50329800
          H                 -0.28839891    1.32763327    2.45691126
    &END COORD
    &KIND Fe
      BASIS_SET DZVP-MOLOPT-SR-GTH
      POTENTIAL GTH-BLYP-q16
    &END KIND
    &KIND H
      BASIS_SET DZVP-MOLOPT-GTH
      POTENTIAL GTH-BLYP-q1
    &END KIND
    &KIND O
      BASIS_SET DZVP-MOLOPT-GTH
      POTENTIAL GTH-BLYP-q6
    &END KIND
    
  &END SUBSYS
&END FORCE_EVAL

