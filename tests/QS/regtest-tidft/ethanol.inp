&GLOBAL
  PROJECT ethanol
  RUN_TYPE ENERGY
  PRINT_LEVEL LOW
&END GLOBAL
&FORCE_EVAL
  METHOD QS
  &DFT
    POTENTIAL_FILE_NAME GTH_POTENTIALS
    BASIS_SET_FILE_NAME GTH_BASIS_SETS
    MULTIPLICITY        1
    !ROKS                TRUE
    &QS
      TIDFT T
      EPS_DEFAULT 1.0E-12
    &END QS

    &TIDFT
      N_EXCITED_STATES           0 !2
      EPS_FILTER                 1.0E-8
      SPIN_PURE                  FALSE !TRUE
      MAX_UNPAIR                 0 !1
      SUGGESTED_MO_BLOCK_SIZE    3
      MO_GUESS                   ATOMIC 
      MO_GUESS_RANDOM_FRAC       0.05
      MO_GUESS_RANDOM_SEED       30304
      STATE_BY_STATE             TRUE
      PRE_ORTHOGONALIZE_STATES   FALSE
      NUMERICAL_GRADIENT         FALSE
      NUMERICAL_GRADIENT_DX      1E-6 ! run w diff vals 10e-4 to -7
      ENERGY_COMPONENT           TRUE
      INTRASTATE_COMPONENT       TRUE
      INTERSTATE_COMPONENT       TRUE

      &TIDFT_OPTIMIZER_PCG
        PRECONDITIONER             QHQ_S
        EPS_ERROR                  1.0E-8
        MAX_ITER                   50
        MAX_ITER_OUTER_LOOP        100
        LIN_SEARCH_EPS_ERROR       0.2
        LIN_SEARCH_STEP_SIZE_GUESS 0.05
        CONJUGATOR                 FLETCHER
      &END TIDFT_OPTIMIZER_PCG

      &PENALTY
        INTRASTATE_NON_PENALTY_STRENGTH    0.
        INTERSTATE_NON_PENALTY_STRENGTH    0.
        PENALTY_STRENGTH_INCREASE_FACTOR   2.0
        ALLOWED_DETERMINANT_DEVIATION      1E-4
      &END PENALTY
    &END TIDFT

    &MGRID
      CUTOFF 200 ! 320
      NGRIDS 5
    &END MGRID
    &XC
      &XC_FUNCTIONAL BLYP
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &SUBSYS
    &CELL
      ABC 4.0351 4.0351 4.0351
      MULTIPLE_UNIT_CELL 1 1 1 
    &END CELL
    &TOPOLOGY
      MULTIPLE_UNIT_CELL 1 1 1
    &END
    &COORD
      SCALED
  H      1.8853     -0.0401      1.0854
  C      1.2699     -0.0477      0.1772
  H      1.5840      0.8007     -0.4449
  H      1.5089     -0.9636     -0.3791
  C     -0.2033      0.0282      0.5345
  H     -0.4993     -0.8287      1.1714
  H     -0.4235      0.9513      1.1064
  O     -0.9394      0.0157     -0.6674
  H     -1.8540      0.0626     -0.4252
    &END COORD
    &KIND O
      BASIS_SET DZVP-GTH 
      POTENTIAL GTH-BLYP-q6
    &END KIND
    &KIND H
      BASIS_SET DZVP-GTH 
      POTENTIAL GTH-BLYP-q1
    &END KIND
    &KIND C
      BASIS_SET DZVP-GTH
      POTENTIAL GTH-BLYP-q4
    &END KIND
  &END SUBSYS
&END FORCE_EVAL

