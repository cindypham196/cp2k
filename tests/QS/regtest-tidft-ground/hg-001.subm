#!/bin/bash
#SBATCH --time=00:60:00
#SBATCH --nodes=10
#SBATCH --tasks-per-node=40
#SBATCH --mem=700G
#SBATCH --account=ctb-rzk
#SBATCH --job-name=hg-001
#SBATCH --error=_hg-001.stde
#SBATCH --output=_hg-001.stdo

EXE=/home/rzk/projects/ctb-rzk/rzk/cp2k-dev/cp2k-tidft/exe/Beluga-Linux-x86-64-gfortran-openmpi/cp2k.psmp
workd=${SLURM_SUBMIT_DIR}
cd $workd
if [ -f "action-pre-001.sh" ]; then
 bash action-pre-001.sh
fi
srun $EXE HexagonalGraphite.inp > $workd/HexagonalGraphite-12x12x1.OT.out-001
if [ -f "action-post-001.sh" ]; then
 bash action-post-001.sh
fi
