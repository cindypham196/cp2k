&GLOBAL
  PROJECT CNT-55
  RUN_TYPE ENERGY
  PRINT_LEVEL MEDIUM !LOW
&END GLOBAL

&FORCE_EVAL

  METHOD QS

  &DFT

    BASIS_SET_FILE_NAME BASIS_MOLOPT
    POTENTIAL_FILE_NAME POTENTIAL

    MULTIPLICITY        1
    UKS                 F
    !ROKS                T

    &QS
      TIDFT                      T       ! RZK: main switch between TIDFT code and OT
      EPS_DEFAULT                1.0E-11
    &END QS

    &TIDFT
      N_EXCITED_STATES           0
      SUGGESTED_MO_BLOCK_SIZE    34           
      EPS_FILTER                 1.0E-10 !1.0E-11
      SPIN_PURE                  FALSE
      MAX_UNPAIR                 0
      MO_GUESS                   ATOMIC
      MO_GUESS_RANDOM_FRAC       0.05
      MO_GUESS_RANDOM_SEED       30304
      STATE_BY_STATE             TRUE
      PRE_ORTHOGONALIZE_STATES   FALSE
      NUMERICAL_GRADIENT         FALSE
      NUMERICAL_GRADIENT_DX      1E-6
      ENERGY_COMPONENT           TRUE
      INTRASTATE_COMPONENT       TRUE
      INTERSTATE_COMPONENT       FALSE

      &TIDFT_OPTIMIZER_PCG
        PRECONDITIONER             QHQ_S
        PREC_WEIGHT_OVERLAP        -1 !0.65 
        EPS_ERROR                  1.0E-8
        WHICH_GRADIENT_NORM        RMS !MAX
        MAX_ITER                   50
        MAX_ITER_OUTER_LOOP        20 !100
        LIN_SEARCH_EPS_ERROR       0.2
        LIN_SEARCH_STEP_SIZE_GUESS 0.05
        CONJUGATOR                 FLETCHER
      &END TIDFT_OPTIMIZER_PCG

      &PENALTY
        INTRASTATE_NON_PENALTY_STRENGTH    1.0E-5   ! RZK: establish optimal value
        INTERSTATE_NON_PENALTY_STRENGTH    0.
        PENALTY_STRENGTH_INCREASE_FACTOR   2.0
        ALLOWED_DETERMINANT_DEVIATION      1E-4
        !MAX_NORM_PHI_OFF_DIAG              5.0E-3
        MAX_CP_STEP                        4 !3
        LOOSE_EPS_SCF                      1E-2
      &END PENALTY

    &END TIDFT

    &SCF
      EPS_SCF 1.0E-8     ! RZK: OT code must use absolute max norm, not rms norm
      MAX_SCF 50
      SCF_GUESS ATOMIC
      &OUTER_SCF
        EPS_SCF 1.0E-8
        MAX_SCF 100
      &END OUTER_SCF
      &OT ON
        !ALGORITHM IRAC
        PRECONDITIONER FULL_SINGLE
        ENERGY_GAP   -1.0
        MINIMIZER CG ! DIIS
      &END OT
      &PRINT
        &RESTART OFF
        &END
      &END
    &END SCF

    &MGRID
      CUTOFF 300
      NGRIDS 5
    &END MGRID

    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
      &VDW_POTENTIAL
         DISPERSION_FUNCTIONAL PAIR_POTENTIAL
         &PAIR_POTENTIAL
            TYPE DFTD3
            CALCULATE_C9_TERM .TRUE.
            REFERENCE_C9_TERM .TRUE.
            LONG_RANGE_CORRECTION .FALSE.
            PARAMETER_FILE_NAME dftd3.dat
            VERBOSE_OUTPUT .TRUE.
            REFERENCE_FUNCTIONAL PBE
            R_CUTOFF [angstrom] 10.0
            EPS_CN 1.0E-6
         &END PAIR_POTENTIAL
      &END VDW_POTENTIAL
    &END XC

  &END DFT

  &SUBSYS

    &CELL
      ABC  10.2 10.2 2.46
      ALPHA_BETA_GAMMA 90.0 90.0 120.0
      MULTIPLE_UNIT_CELL 1 1 13
    &END CELL

    &TOPOLOGY
      MULTIPLE_UNIT_CELL 1 1 13
    &END    

    &COORD
  C        5.951143     4.402090     0.000000
  C        5.655031     5.791895     0.000000
  C        5.299968     6.406199     1.231179
  C        4.243502     7.356525     1.231179
  C        3.595170     7.644807     0.000000
  C        2.181883     7.792662     0.000000
  C        1.487925     7.644807     1.231179
  C        0.257645     6.933715     1.231179
  C       -0.216873     6.406199     0.000000
  C       -0.794221     5.107773     0.000000
  C       -0.868048     4.402090     1.231179
  C       -0.571936     3.012284     1.231179
  C       -0.216873     2.397980     0.000000
  C        0.839594     1.447654     0.000000
  C        1.487925     1.159372     1.231179
  C        2.901212     1.011517     1.231179
  C        3.595170     1.159372     0.000000
  C        4.825450     1.870464     0.000000
  C        5.299968     2.397980     1.231179
  C        5.877316     3.696406     1.231179
    
    &END COORD

    &KIND C
      BASIS_SET DZVP-MOLOPT-SR-GTH-q4   ! RZK: For large-basis calculations use: TZV2PX-MOLOPT-GTH-q4
      POTENTIAL GTH-PBE-q4
    &END KIND
    &KIND H
      BASIS_SET DZVP-MOLOPT-SR-GTH-q1   ! RZK: For large-basis calculations use: TZV2PX-MOLOPT-GTH-q1
      POTENTIAL GTH-PBE-q1
    &END KIND
  &END SUBSYS

&END FORCE_EVAL

