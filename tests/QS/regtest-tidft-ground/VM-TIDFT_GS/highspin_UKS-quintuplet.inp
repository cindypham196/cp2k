&GLOBAL
  PROJECT Cr(I)6
  RUN_TYPE ENERGY
  PRINT_LEVEL LOW
&END GLOBAL
&FORCE_EVAL
  METHOD QS
  &DFT
    BASIS_SET_FILE_NAME BASIS_MOLOPT 
    POTENTIAL_FILE_NAME POTENTIAL

    CHARGE              -4    ! RZK:[Cr(I)6]4-
    MULTIPLICITY         5    ! RZK: I am not sure what multiplicites we decided to try. Compare energies for: 1,3,5 (or 2,4,6?)
    UKS                 T    ! == LSD?  RZK: UKS - compare to OT.
    !ROKS                T   ! RZK: Also, perform ROKS with TIDFT (same multiplicities)

    &MGRID
      CUTOFF 300
      NGRIDS 4
    &END MGRID

    &QS
      TIDFT  T
      EPS_DEFAULT  1.0E-11 !1.0E-12
    &END QS

    &TIDFT
      N_EXCITED_STATES           0
      SUGGESTED_MO_BLOCK_SIZE    34
      EPS_FILTER                 1.0E-11
      SPIN_PURE                  FALSE
      MAX_UNPAIR                 4
      MO_GUESS_RANDOM_FRAC       0.05
      MO_GUESS_RANDOM_SEED       30304
      STATE_BY_STATE             TRUE
      PRE_ORTHOGONALIZE_STATES   FALSE
      NUMERICAL_GRADIENT         FALSE
      NUMERICAL_GRADIENT_DX      1E-6
      ENERGY_COMPONENT           TRUE
      INTRASTATE_COMPONENT       TRUE
      INTERSTATE_COMPONENT       TRUE

      &TIDFT_OPTIMIZER_PCG
        PRECONDITIONER             QHQ_S
        PREC_WEIGHT_OVERLAP         -1 
        EPS_ERROR                  1.0E-8
        WHICH_GRADIENT_NORM         RMS
        MAX_ITER                   50
        MAX_ITER_OUTER_LOOP        20 !100
        LIN_SEARCH_EPS_ERROR       0.2
        LIN_SEARCH_STEP_SIZE_GUESS 0.05
        CONJUGATOR                 FLETCHER
      &END TIDFT_OPTIMIZER_PCG

      &PENALTY
        INTRASTATE_NON_PENALTY_STRENGTH    1E-5
        INTERSTATE_NON_PENALTY_STRENGTH    1
        PENALTY_STRENGTH_INCREASE_FACTOR   2.0
        !ALLOWED_DETERMINANT_DEVIATION      1E-4
        MAX_NORM_PHI_OFF_DIAG              5.0E-3
        MAX_CP_STEP                         4
        LOOSE_EPS_SCF                     1E-2
      &END PENALTY

    &END TIDFT

    &SCF
      SCF_GUESS ATOMIC
      EPS_SCF 1.0E-8
      MAX_SCF 50
      &OT ON
        !ALGORITHM IRAC
        !MINIMIZER DIIS
        PRECONDITIONER FULL_SINGLE_INVERSE !FULL_ALL
        ROTATION T
      &END OT
      &OUTER_SCF
         EPS_SCF 1.0E-8
         MAX_SCF 20 !100
      &END
      &PRINT
        &RESTART OFF
        &END
      &END
    &END SCF
    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &SUBSYS
    &CELL
      ABC 10.0  10.0  10.0
      MULTIPLE_UNIT_CELL 1 1 1
    &END CELL
    &TOPOLOGY
      MULTIPLE_UNIT_CELL 1 1 1
    &END
    &COORD
       Cr                -3.66956509   -0.49565217    0.00000000
        I                 -6.12956509   -0.49565217    0.00000000
        I                 -3.66956509    1.96434783    0.00000000
        I                 -3.66956509   -0.49565217    2.46000000
        I                 -3.66956509   -2.95565217    0.00000000
        I                 -1.20956509   -0.49565217    0.00000000
        I                 -3.66956509   -0.49565217   -2.46000000
    &END COORD
    &KIND Cr
      BASIS_SET DZVP-MOLOPT-SR-GTH
      POTENTIAL GTH-BLYP-q14
      &BS 
        &ALPHA ! Modification to the spin-up initial MOs 
          NEL +2 ! Transfer 2 beta electrons to alpha (on Cr cation)
          N 3
          L 2
        &END ALPHA
        &BETA ! Modification to the spin-down initial MOs 
          NEL -2 ! Transfer 2 beta electrons to alpha (on Cr cation)
          N 3
          L 2
        &END BETA
      &END BS 
    &END KIND
    &KIND I
      BASIS_SET DZVP-MOLOPT-SR-GTH
      POTENTIAL GTH-BLYP-q7
    &END KIND
  &END SUBSYS
&END FORCE_EVAL

