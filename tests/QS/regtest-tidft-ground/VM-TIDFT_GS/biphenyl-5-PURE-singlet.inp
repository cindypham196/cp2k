&GLOBAL
  PROJECT  diradical
  RUN_TYPE ENERGY
  PRINT_LEVEL LOW
&END GLOBAL
&FORCE_EVAL
  METHOD QS
  &DFT
    BASIS_SET_FILE_NAME GTH_BASIS_SETS
    POTENTIAL_FILE_NAME POTENTIAL
    &MGRID
      CUTOFF 300
      NGRIDS 4
    &END MGRID
    CHARGE               0
    MULTIPLICITY         1
    ROKS                 T
    UKS                  F ! RZK: Perform several sets of calculations:
                           !   1. UKS=T, ROKS=F, MULTIPLICITY=1; singlet (compare to OT)
                           !   2. UKS=T, ROKS=F, MULTIPLICITY=3; triplet (compare to OT)
                           !   3. UKS=F, ROKS=T, SPIN_PURE=F, MULTIPLICITY=1
                           !   4. UKS=F, ROKS=T, SPIN_PURE=F, MULTIPLICITY=3
                           !   5. UKS=F, ROKS=T, SPIN_PURE=T, MULTIPLICITY=1
    &QS
      TIDFT  T
      EPS_DEFAULT 1.0E-12
    &END QS

    &TIDFT
      N_EXCITED_STATES           0
      SUGGESTED_MO_BLOCK_SIZE    34
      EPS_FILTER                 1.0E-11
      SPIN_PURE                  TRUE
      MAX_UNPAIR                 1
      MO_GUESS_RANDOM_FRAC       0.05
      MO_GUESS_RANDOM_SEED       30304
      STATE_BY_STATE             TRUE
      PRE_ORTHOGONALIZE_STATES   FALSE
      NUMERICAL_GRADIENT         FALSE
      NUMERICAL_GRADIENT_DX      1E-6
      ENERGY_COMPONENT           TRUE
      INTRASTATE_COMPONENT       TRUE
      INTERSTATE_COMPONENT       TRUE

      &TIDFT_OPTIMIZER_PCG
        PRECONDITIONER             QHQ_S
        PREC_WEIGHT_OVERLAP        0.85 !0.8
        EPS_ERROR                  1.0E-8
        MAX_ITER                   50 !200
        MAX_ITER_OUTER_LOOP        20 !100
        LIN_SEARCH_EPS_ERROR       0.2
        LIN_SEARCH_STEP_SIZE_GUESS 0.05
        CONJUGATOR                 FLETCHER
      &END TIDFT_OPTIMIZER_PCG

      &PENALTY
        INTRASTATE_NON_PENALTY_STRENGTH    1E-5
        INTERSTATE_NON_PENALTY_STRENGTH    1
        PENALTY_STRENGTH_INCREASE_FACTOR   2.0
        ALLOWED_DETERMINANT_DEVIATION      1E-4
        MAX_CP_STEP                        4 !3
        LOOSE_EPS_SCF                      1E-2
      &END PENALTY

    &END TIDFT

    &SCF
      SCF_GUESS ATOMIC
      EPS_SCF 1.0E-8
      MAX_SCF 50 !30
      &OT ON
        !ALGORITHM IRAC
        !MINIMIZER DIIS
        PRECONDITIONER FULL_SINGLE_INVERSE !FULL_ALL
      &END OT
      &OUTER_SCF
         EPS_SCF 1.0E-8
         MAX_SCF 20 !5
      &END
      &PRINT
        &RESTART OFF
        &END
      &END
    &END SCF
    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &SUBSYS
    &CELL
      ABC  15.0 15.0 15.0  !15.0795 14.78295  14.5827 ! RZK: Why cell has such weird size? Why not use 15.0 15.0 15.0?
      MULTIPLE_UNIT_CELL 1 1 1 ! RZK: No need to multiply the cell for gas-phase molecules
    &END CELL
    &TOPOLOGY
      MULTIPLE_UNIT_CELL 1 1 1
    &END
    &COORD  !optimized coords
  O         0.1940105032        2.1503175121        4.5032022785
  O         4.2168093926        2.1578372049        9.1783319446
  N         1.4477187795        1.9938566778        4.7844556951
  N         4.1203638560        0.9180983413        8.8231494921
  C         1.7587527329        1.1465161589        5.9131480867
  C         2.8053460605        1.4533388249        6.8112136254
  C         3.0599380692        0.5828218682        7.8966827486
  C         2.2428412423       -0.5475938324        8.1123019208
  C         1.1623558814       -0.8347343204        7.2399369092
  C         0.9296508812        0.0206073284        6.1395685462
  C         0.2943688182       -2.0219562084        7.4901020869
  C        -0.2355124516       -2.7794717499        6.4138434801
  C        -1.0424131366       -3.9080545068        6.6538212827
  C        -1.3404413892       -4.3027814614        7.9738057548
  C        -0.8242184896       -3.5561344616        9.0527255421
  C        -0.0141762544       -2.4301202104        8.8132198780
  C         2.4215629822        2.1637800109        3.6143272532
  C         1.9340398218        3.3674903018        2.7894700530
  C         2.3363454566        0.8616559998        2.7866214532
  C         3.8664692251        2.4120399799        4.0783607250
  C         5.3951003631        0.0791983239        8.9033091652
  C         5.0866707852       -1.4252353997        8.9999790621
  C         6.1583422125        0.5340442634       10.1585897923
  C         6.2149569308        0.3816606204        7.6289811930
  H         3.4030774594        2.3667942632        6.7129201594
  H         2.4352124424       -1.2020677612        8.9704377582
  H         0.0773103451       -0.1399025126        5.4658867326
  H         0.0081896435       -2.4944916262        5.3790594341
  H        -1.4380048224       -4.4854570402        5.8041552329
  H        -1.9713464030       -5.1857795245        8.1612316605
  H        -1.0595315198       -3.8472009489       10.0878764849
  H         0.3568083983       -1.8377533960        9.6637679823
  H         2.5824914225        3.4837278312        1.8980989462
  H         1.9853221493        4.3002938687        3.3859224481
  H         0.8895745943        3.2214677891        2.4601292094
  H         1.2906401632        0.6877837153        2.4625478637
  H         2.6766732217       -0.0112912161        3.3806932916
  H         2.9779393197        0.9403109669        1.8854341414
  H         4.4934649399        2.5711328933        3.1778464928
  H         3.9428344096        3.3226907842        4.7051581171
  H         4.2901051702        1.5533188868        4.6335469214
  H         4.5712809158       -1.8146929859        8.1014936726
  H         6.0460927182       -1.9715067777        9.1010268264
  H         4.4741854015       -1.6543300107        9.8949825591
  H         6.3757538068        1.6164418744       10.1174538950
  H         5.5645461665        0.3330930110       11.0728017154
  H         7.1113031996       -0.0275011741       10.2259318202
  H         7.1782095831       -0.1671287796        7.6579363490
  H         6.4321590702        1.4666178117        7.5641128536
  H         5.6675496310        0.0698502980        6.7155980564
    &END COORD
    &KIND C
      BASIS_SET DZVP-GTH
      POTENTIAL GTH-BLYP-q4
    &END KIND
    &KIND O
      BASIS_SET DZVP-GTH
      POTENTIAL GTH-BLYP-q6
      &BS
        ! RZK: Break spin symmetry as shown for small diradicals. It is better to create spin-density 
        !on atoms that are expected to carry unpaired electrons. In this case, SCF will converge faster.
        &ALPHA       ! Modification to the spin-up initial MOs
           NEL     +1    ! Transfer 1 beta electron to alpha (on each O atom)
           N        2
           L        1
        &END ALPHA
        &BETA        ! Modification to the spin-down initial MOs
           NEL     -1   ! Transfer 1 beta electron to alpha (on O atom)
           N        2
           L        1
        &END BETA
      &END BS
    &END KIND
     &KIND N
      BASIS_SET DZVP-GTH
      POTENTIAL GTH-BLYP-q5
    &END KIND
     &KIND H
      BASIS_SET DZVP-GTH
      POTENTIAL GTH-BLYP-q1
    &END KIND
  &END SUBSYS
&END FORCE_EVAL

