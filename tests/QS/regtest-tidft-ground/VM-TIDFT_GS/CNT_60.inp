&GLOBAL
  PROJECT CNT-zz
  RUN_TYPE ENERGY
  PRINT_LEVEL MEDIUM !LOW
&END GLOBAL

&FORCE_EVAL

  METHOD QS

!  &PROPERTIES
!    &TDDFPT
!      NSTATES     2 !10             # number of excited states
!      MAX_ITER    50             # maximum number of Davidson iterations
!      CONVERGENCE [eV] 1.0e-6    # convergence on maximum energy change between iterations
!      &MGRID
!          CUTOFF 300              # separate cutoff for TDDFPT calc
!      &END
!    &END TDDFPT
!  &END PROPERTIES

  &DFT

    BASIS_SET_FILE_NAME BASIS_MOLOPT
    POTENTIAL_FILE_NAME POTENTIAL

    MULTIPLICITY        1
    !UKS                 T
    !ROKS                T

    &QS
      TIDFT                      T !F       ! RZK: main switch between TIDFT code and OT
      EPS_DEFAULT                1.0E-11
    &END QS

    &TIDFT
      N_EXCITED_STATES           0 !2 !4
      SUGGESTED_MO_BLOCK_SIZE    34           
      EPS_FILTER                 1.0E-10    
      SPIN_PURE                  FALSE !TRUE !
      MAX_UNPAIR                 0
      MO_GUESS                   ATOMIC
      MO_GUESS_RANDOM_FRAC       0.05
      MO_GUESS_RANDOM_SEED       30304
      STATE_BY_STATE             TRUE
      PRE_ORTHOGONALIZE_STATES   FALSE
      NUMERICAL_GRADIENT         FALSE
      NUMERICAL_GRADIENT_DX      1E-6
      ENERGY_COMPONENT           TRUE
      INTRASTATE_COMPONENT       TRUE
      INTERSTATE_COMPONENT       TRUE

      &TIDFT_OPTIMIZER_PCG
        PRECONDITIONER             QHQ_S
        PREC_WEIGHT_OVERLAP        -99 !0.65
        EPS_ERROR                  1.0E-8 
        WHICH_GRADIENT_NORM        RMS 
        MAX_ITER                   50
        MAX_ITER_OUTER_LOOP        20 !100
        LIN_SEARCH_EPS_ERROR       0.2
        LIN_SEARCH_STEP_SIZE_GUESS 0.05
        CONJUGATOR                 FLETCHER
      &END TIDFT_OPTIMIZER_PCG

      &PENALTY
        INTRASTATE_NON_PENALTY_STRENGTH    1.0E-5     ! RZK: establish optimal value
        INTERSTATE_NON_PENALTY_STRENGTH    0 !1E-3
        PENALTY_STRENGTH_INCREASE_FACTOR   2.0
        !ALLOWED_DETERMINANT_DEVIATION      1E-4
        MAX_NORM_PHI_OFF_DIAG              5.0E-3
        MAX_CP_STEP                        4
        LOOSE_EPS_SCF                      1E-2
      &END PENALTY

    &END TIDFT

    &SCF
      EPS_SCF 1.0E-6 !1.0E-8     ! RZK: OT code must use absolute max norm, not rms norm
      MAX_SCF 50
      SCF_GUESS ATOMIC
      &OUTER_SCF
        EPS_SCF 1.0E-6 !1.0E-8
        MAX_SCF 20 !100
      &END OUTER_SCF
!      &OT ON
!        !ALGORITHM IRAC
!        PRECONDITIONER FULL_SINGLE
!        ENERGY_GAP   -1.0
!        MINIMIZER CG ! DIIS
!      &END OT
      &PRINT
        &RESTART OFF
        &END
      &END
    &END SCF

    &MGRID
      CUTOFF 300
      NGRIDS 5
    &END MGRID

    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
      &VDW_POTENTIAL
         DISPERSION_FUNCTIONAL PAIR_POTENTIAL
         &PAIR_POTENTIAL
            TYPE DFTD3
            CALCULATE_C9_TERM .TRUE.
            REFERENCE_C9_TERM .TRUE.
            LONG_RANGE_CORRECTION .FALSE.
            PARAMETER_FILE_NAME dftd3.dat
            VERBOSE_OUTPUT .TRUE.
            REFERENCE_FUNCTIONAL PBE
            R_CUTOFF [angstrom] 10.0
            EPS_CN 1.0E-6
         &END PAIR_POTENTIAL
      &END VDW_POTENTIAL
    &END XC

  &END DFT

  &SUBSYS

    &CELL
      ABC 8.09 8.09 4.28 ! 10.5 10.5 4.27 this is (9,0)
      ALPHA_BETA_GAMMA 90.0 90.0 120.0
      MULTIPLE_UNIT_CELL 1 1 13  !10 12 9 8
    &END CELL

    &TOPOLOGY
      MULTIPLE_UNIT_CELL 1 1 13 !10 12 9 8
    &END    

    &COORD
    C        4.392539     3.502229     1.421000
    C        4.392539     3.502229     0.000000
    C        4.074948     4.687492     3.558610
    C        4.074948     4.687492     2.137610
    C        3.207276     5.555165     1.421000
    C        3.207276     5.555165     0.000000
    C        2.022013     5.872755     3.558610
    C        2.022013     5.872755     2.137610
    C        0.836750     5.555165     1.421000
    C        0.836750     5.555165     0.000000
    C       -0.030923     4.687492     3.558610
    C       -0.030923     4.687492     2.137610
    C       -0.348513     3.502229     1.421000
    C       -0.348513     3.502229     0.000000
    C       -0.030923     2.316966     3.558610
    C       -0.030923     2.316966     2.137610
    C        0.836750     1.449294     1.421000
    C        0.836750     1.449294     0.000000
    C        2.022013     1.131703     3.558610
    C        2.022013     1.131703     2.137610
    C        3.207276     1.449294     1.421000
    C        3.207276     1.449294     0.000000
    C        4.074948     2.316966     3.558610
    C        4.074948     2.316966     2.137610
    &END COORD

    &KIND C
      BASIS_SET DZVP-MOLOPT-SR-GTH-q4   ! RZK: For large-basis calculations use: TZV2PX-MOLOPT-GTH-q4
      POTENTIAL GTH-PBE-q4
    &END KIND
  &END SUBSYS

&END FORCE_EVAL

