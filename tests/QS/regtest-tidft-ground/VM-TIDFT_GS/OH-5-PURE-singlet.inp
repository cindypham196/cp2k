&GLOBAL
  PROJECT  diradical
  RUN_TYPE ENERGY
  PRINT_LEVEL LOW
&END GLOBAL
&FORCE_EVAL
  METHOD QS
  &DFT
    BASIS_SET_FILE_NAME GTH_BASIS_SETS
    POTENTIAL_FILE_NAME POTENTIAL
    &MGRID
      CUTOFF 300
      NGRIDS 4
    &END MGRID
    CHARGE               1
    MULTIPLICITY         1
    ROKS                 T
    UKS                  F ! RZK: Perform several sets of calculations:
                           !   1. UKS=T, ROKS=F, MULTIPLICITY=1; singlet (compare to OT)
                           !   2. UKS=T, ROKS=F, MULTIPLICITY=3; triplet (compare to OT)
                           !   3. UKS=F, ROKS=T, SPIN_PURE=F, MULTIPLICITY=1
                           !   4. UKS=F, ROKS=T, SPIN_PURE=F, MULTIPLICITY=3
                           !   5. UKS=F, ROKS=T, SPIN_PURE=T, MULTIPLICITY=1
    &QS
      TIDFT  T
      EPS_DEFAULT 1.0E-12
    &END QS

    &TIDFT
      N_EXCITED_STATES           0
      SUGGESTED_MO_BLOCK_SIZE    34
      EPS_FILTER                 1.0E-11
      SPIN_PURE                  TRUE
      MAX_UNPAIR                 1
      MO_GUESS_RANDOM_FRAC       0.05
      MO_GUESS_RANDOM_SEED       30304
      STATE_BY_STATE             TRUE
      PRE_ORTHOGONALIZE_STATES   FALSE
      NUMERICAL_GRADIENT         FALSE !TRUE !FALSE
      NUMERICAL_GRADIENT_DX      1E-6
      ENERGY_COMPONENT           TRUE
      INTRASTATE_COMPONENT       TRUE
      INTERSTATE_COMPONENT       TRUE

      &TIDFT_OPTIMIZER_PCG
        PRECONDITIONER             QHQ_S !S
        PREC_WEIGHT_OVERLAP        0.9 !0.95
        EPS_ERROR                  1.0E-8
        WHICH_GRADIENT_NORM         RMS
        MAX_ITER                   100 !200
        MAX_ITER_OUTER_LOOP        50 !100
        LIN_SEARCH_EPS_ERROR       0.2
        LIN_SEARCH_STEP_SIZE_GUESS 0.05
        CONJUGATOR                 FLETCHER 
      &END TIDFT_OPTIMIZER_PCG

      &PENALTY
        INTRASTATE_NON_PENALTY_STRENGTH    1E-5
        INTERSTATE_NON_PENALTY_STRENGTH    1
        PENALTY_STRENGTH_INCREASE_FACTOR   2.0
        ALLOWED_DETERMINANT_DEVIATION      1E-4
        MAX_CP_STEP                        4 !3
        LOOSE_EPS_SCF                      1E-2
      &END PENALTY

    &END TIDFT

    &SCF
      SCF_GUESS ATOMIC
      EPS_SCF 1.0E-8
      MAX_SCF 200 !30
      &OT ON
        !ALGORITHM IRAC
        !MINIMIZER DIIS
        PRECONDITIONER FULL_ALL
      &END OT
      &OUTER_SCF
         EPS_SCF 1.0E-8
         MAX_SCF 100 !5
      &END
      &PRINT
        &RESTART OFF
        &END
      &END
    &END SCF
    &XC
      &XC_FUNCTIONAL PBE !BLYP !PBE !
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &SUBSYS
    &CELL
      ABC 10.0 10.0 10.0
      MULTIPLE_UNIT_CELL 1 1 1
    &END CELL
    &TOPOLOGY
      MULTIPLE_UNIT_CELL 1 1 1
    &END
    ! Geometry is taken from DOI: 10.1021/jp109280y
    &COORD
      H 0.0000000 0.0000000 -0.9351540
      O 0.0000000 0.0000000 0.1168940
    &END COORD
    &KIND O
      BASIS_SET aug-TZV2P-GTH   !DZVP-GTH   ! RZK: use larger basis set
      POTENTIAL GTH-BLYP-q6
      &BS            ! RZK: You can see how initial atomic configurations change in the output file
        &ALPHA       ! Modification to the spin-up initial MOs
           NEL     +2    ! Transfer 1 beta electron to alpha (on O atom)
           N        2
           L        1
        &END ALPHA
        &BETA        ! Modification to the spin-down initial MOs
           NEL     -2    ! Transfer 1 beta electron to alpha (on O atom)
           N        2
           L        1
        &END BETA
      &END BS
    &END KIND
    &KIND H
      BASIS_SET aug-TZV2P-GTH !DZVP-GTH   ! RZK: larger
      POTENTIAL GTH-BLYP-q1
      &BS
        &ALPHA
           NEL      0    ! Do not do anything to hydrogen (the H's &BS can be deleted)
           N        1
           L        0
        &END ALPHA
        &BETA
           NEL      0
           N        1
           L        0
        &END BETA
      &END BS
    &END KIND
  &END SUBSYS
&END FORCE_EVAL

