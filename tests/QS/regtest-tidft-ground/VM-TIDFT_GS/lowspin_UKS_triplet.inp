&GLOBAL
  PROJECT Cr(CN)6
  RUN_TYPE ENERGY
  PRINT_LEVEL MEDIUM !LOW
&END GLOBAL
&FORCE_EVAL
  METHOD QS
  &DFT
    BASIS_SET_FILE_NAME BASIS_MOLOPT 
    POTENTIAL_FILE_NAME POTENTIAL

    CHARGE              -4    ! RZK:[Cr(CN)6]4-
    MULTIPLICITY         3    ! RZK: I am not sure what multiplicites we decided to try. Compare energies for: 1,3,5 (or 2,4,6?)
    UKS                 T    ! == LSD?  RZK: UKS - compare to OT.
    !ROKS                T   ! RZK: Also, perform ROKS with TIDFT (same multiplicities)

    &MGRID
      CUTOFF 300
      NGRIDS 4
    &END MGRID

    &QS
      TIDFT  T
      EPS_DEFAULT 1.0E-12
    &END QS

    &TIDFT
      N_EXCITED_STATES           0
      SUGGESTED_MO_BLOCK_SIZE    34
      EPS_FILTER                 1.0E-8
      SPIN_PURE                  FALSE
      MAX_UNPAIR                 2
      MO_GUESS_RANDOM_FRAC       0.05
      MO_GUESS_RANDOM_SEED       30304
      STATE_BY_STATE             TRUE
      PRE_ORTHOGONALIZE_STATES   FALSE
      NUMERICAL_GRADIENT         FALSE
      NUMERICAL_GRADIENT_DX      1E-6
      ENERGY_COMPONENT           TRUE
      INTRASTATE_COMPONENT       TRUE
      INTERSTATE_COMPONENT       TRUE

      &TIDFT_OPTIMIZER_PCG
        PRECONDITIONER             QHQ_S
        PREC_WEIGHT_OVERLAP        -1
        EPS_ERROR                  1.0E-8
        WHICH_GRADIENT_NORM        RMS
        MAX_ITER                   50
        MAX_ITER_OUTER_LOOP        100
        LIN_SEARCH_EPS_ERROR       0.2
        LIN_SEARCH_STEP_SIZE_GUESS 0.05
        CONJUGATOR                 FLETCHER
      &END TIDFT_OPTIMIZER_PCG

      &PENALTY
        INTRASTATE_NON_PENALTY_STRENGTH    1E-5
        INTERSTATE_NON_PENALTY_STRENGTH    1
        PENALTY_STRENGTH_INCREASE_FACTOR   2.0
        MAX_NORM_PHI_OFF_DIAG              5.0E-3
        !ALLOWED_DETERMINANT_DEVIATION      1E-4
        MAX_CP_STEP                         4
        LOOSE_EPS_SCF                     1E-2
      &END PENALTY

    &END TIDFT

    &SCF
      SCF_GUESS ATOMIC
      EPS_SCF 1.0E-8
      MAX_SCF 50
      &OT ON
        !ALGORITHM IRAC
        !MINIMIZER DIIS
        PRECONDITIONER FULL_SINGLE_INVERSE !FULL_ALL
        ROTATION T
      &END OT
      &OUTER_SCF
         EPS_SCF 1.0E-8
         MAX_SCF 100 !5
      &END
      &PRINT
        &RESTART OFF
        &END
      &END
    &END SCF
    &XC
      &XC_FUNCTIONAL PBE !BLYP
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &SUBSYS
    &CELL
      ABC 10.0  10.0  10.0
      MULTIPLE_UNIT_CELL 1 1 1
    &END CELL
    &TOPOLOGY
      MULTIPLE_UNIT_CELL 1 1 1
    &END
    &COORD
      Cr                 3.54660000    3.54660000    3.54660000
      C                  1.64660000    3.54660000    3.54660000
      C                  3.54660000    5.44660000    3.54660000
      C                  3.54660000    3.54660000    1.64660000
      C                  5.44660000    3.54660000    3.54660000
      C                  3.54660000    1.64660000    3.54660000
      C                  3.54660000    3.54660000    5.44660000
      N                  0.50000000    3.54660000    3.54660000
      N                  3.54660000    6.59320000    3.54660000
      N                  3.54660000    3.54660000    6.59320000
      N                  3.54660000    3.54660000    0.50000000
      N                  3.54660000    0.50000000    3.54660000
      N                  6.59320000    3.54660000    3.54660000
    &END COORD
    &KIND Cr
      BASIS_SET DZVP-MOLOPT-SR-GTH
      POTENTIAL GTH-BLYP-q14
      &BS 
        &ALPHA ! Modification to the spin-up initial MOs 
          NEL +2 ! Transfer 2 beta electrons to alpha (on Cr cation)
          N 3
          L 2
        &END ALPHA
        &BETA ! Modification to the spin-down initial MOs 
          NEL -2 ! Transfer 2 beta electrons to alpha (on Cr cation)
          N 3
          L 2
        &END BETA
      &END BS 
    &END KIND
    &KIND C
      BASIS_SET DZVP-MOLOPT-GTH
      POTENTIAL GTH-BLYP-q4
    &END KIND
    &KIND N
      BASIS_SET DZVP-MOLOPT-GTH
      POTENTIAL GTH-BLYP-q5
    &END KIND
  &END SUBSYS
&END FORCE_EVAL

