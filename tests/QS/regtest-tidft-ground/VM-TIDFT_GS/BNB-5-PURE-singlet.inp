&GLOBAL
  PROJECT BNB
  RUN_TYPE ENERGY
  PRINT_LEVEL LOW
&END GLOBAL
&FORCE_EVAL
  METHOD QS
  &DFT
    BASIS_SET_FILE_NAME GTH_BASIS_SETS
    POTENTIAL_FILE_NAME POTENTIAL
    &MGRID
      CUTOFF 300
      NGRIDS 4
    &END MGRID
    CHARGE               0
    MULTIPLICITY         1
    UKS                  F
    ROKS                 T  !   5. UKS=F, ROKS=T, SPIN_PURE=T, MULTIPLICITY=1
    &QS
      TIDFT  T
      EPS_DEFAULT  1.0E-11 !1.0E-12
    &END QS

    &TIDFT
      N_EXCITED_STATES           0
      SUGGESTED_MO_BLOCK_SIZE    34
      EPS_FILTER                 1.0E-11
      SPIN_PURE                  TRUE
      MAX_UNPAIR                 1
      MO_GUESS_RANDOM_FRAC       0.05
      MO_GUESS_RANDOM_SEED       30304
      STATE_BY_STATE             TRUE
      PRE_ORTHOGONALIZE_STATES   FALSE
      NUMERICAL_GRADIENT         FALSE
      NUMERICAL_GRADIENT_DX      1E-6
      ENERGY_COMPONENT           TRUE
      INTRASTATE_COMPONENT       TRUE
      INTERSTATE_COMPONENT       TRUE

      &TIDFT_OPTIMIZER_PCG
        PRECONDITIONER             QHQ_S
        PREC_WEIGHT_OVERLAP        0.85
        EPS_ERROR                  1.0E-8
        WHICH_GRADIENT_NORM        RMS
        MAX_ITER                   50
        MAX_ITER_OUTER_LOOP        20 !100
        LIN_SEARCH_EPS_ERROR       0.2
        LIN_SEARCH_STEP_SIZE_GUESS 0.05
        CONJUGATOR                 FLETCHER
      &END TIDFT_OPTIMIZER_PCG

      &PENALTY
        INTRASTATE_NON_PENALTY_STRENGTH    1E-5
        INTERSTATE_NON_PENALTY_STRENGTH    1
        PENALTY_STRENGTH_INCREASE_FACTOR   2.0
        ALLOWED_DETERMINANT_DEVIATION      1E-4
        MAX_CP_STEP                        4
        LOOSE_EPS_SCF                     1E-2
      &END PENALTY

    &END TIDFT

    &SCF
      SCF_GUESS ATOMIC
      EPS_SCF 1.0E-8
      MAX_SCF 50 !30
      &OT ON
        !ALGORITHM IRAC
        !MINIMIZER DIIS
        PRECONDITIONER FULL_ALL
      &END OT
      &OUTER_SCF
         EPS_SCF 1.0E-8
         MAX_SCF 100 !5
      &END
      &PRINT
        &RESTART OFF
        &END
      &END
    &END SCF
    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &SUBSYS
    &CELL
      ABC  15.0 15.0 15.0  !15.0795 14.78295  14.5827 ! RZK: Why cell has such weird size? Why not use 15.0 15.0 15.0?
      MULTIPLE_UNIT_CELL 1 1 1 ! RZK: No need to multiply the cell for gas-phase molecules
    &END CELL
    &TOPOLOGY
      MULTIPLE_UNIT_CELL 1 1 1
    &END
    &COORD !optimize coords
  C        -2.0453788761        0.3738082058       -0.5625723709
  C        -0.5315675450        0.4199970886       -0.5625745653
  C        -1.3515959715        2.6684055941       -0.5624880637
  N        -2.4522517449        1.8087387099       -0.5625064916
  H        -2.4931030636       -0.0907575874        0.3366460097
  H        -0.0565416108       -0.0138658567        0.3378402077
  C        -1.4242724031        4.1524038779       -0.5624962829
  N        -0.3150553649        5.0077725091       -0.5625403114
  C        -2.2395006100        6.4032990456       -0.5628873820
  C        -0.7257568081        6.4422794801       -0.5628798988
  H        -2.7115637228        6.8426047989        0.3363582917
  H        -0.2757231382        6.9043904657        0.3363575626
  N        -2.5846773328        4.9511343140       -0.5625371831
  N        -0.1957159785        1.8761946180       -0.5625080298
  H        -2.4930901525       -0.0906383427       -1.4618596040
  H        -0.0565623791       -0.0137495237       -1.4630573958
  H        -0.2757702130        6.9038735731       -1.4624151924
  H        -2.7114639612        6.8420536701       -1.4624607766
  O        -3.8278634859        4.6857562366       -0.5624802052
  O        -3.6935634062        2.0563346896       -0.5625140600
  O         0.9330651979        4.7813338314       -0.5624891325
  O         1.0381970805        2.1576174641       -0.5624964674
    &END COORD
    &KIND C
      BASIS_SET DZVP-GTH
      POTENTIAL GTH-BLYP-q4
    &END KIND
    &KIND O
      BASIS_SET DZVP-GTH
      POTENTIAL GTH-BLYP-q6
      &BS
        ! RZK: Break spin symmetry as shown for small diradicals. It is better to create spin-density 
        !on atoms that are expected to carry unpaired electrons. In this case, SCF will converge faster.
        &ALPHA       ! Modification to the spin-up initial MOs
           NEL     +1    ! Transfer 1 beta electron to alpha (on each O atom)
           N        2
           L        1
        &END ALPHA
        &BETA        ! Modification to the spin-down initial MOs
           NEL     -1   ! Transfer 1 beta electron to alpha (on O atom)
           N        2
           L        1
        &END BETA
      &END BS
    &END KIND
     &KIND N
      BASIS_SET DZVP-GTH
      POTENTIAL GTH-BLYP-q5
    &END KIND
     &KIND H
      BASIS_SET DZVP-GTH
      POTENTIAL GTH-BLYP-q1
    &END KIND
  &END SUBSYS
&END FORCE_EVAL

