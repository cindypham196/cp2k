&GLOBAL
  PROJECT O3
  RUN_TYPE ENERGY
  PRINT_LEVEL MEDIUM !LOW
&END GLOBAL

&FORCE_EVAL
  METHOD QS
  &DFT

    BASIS_SET_FILE_NAME GTH_BASIS_SETS
    POTENTIAL_FILE_NAME POTENTIAL
    MULTIPLICITY        1
    UKS                 T
    !ROKS                T

    &QS
      TIDFT T !F
      EPS_DEFAULT 1.0E-11
    &END QS

    &TIDFT
      N_EXCITED_STATES           0 !4
      SUGGESTED_MO_BLOCK_SIZE    3
      EPS_FILTER                 1.0E-10
      SPIN_PURE                  FALSE
      MAX_UNPAIR                 1
      MO_GUESS_RANDOM_FRAC       0.05
      MO_GUESS_RANDOM_SEED       30304
      STATE_BY_STATE             TRUE
      PRE_ORTHOGONALIZE_STATES   FALSE
      NUMERICAL_GRADIENT         FALSE
      NUMERICAL_GRADIENT_DX      1E-6 ! run w diff vals 10e-4 to -7
      ENERGY_COMPONENT           TRUE
      INTRASTATE_COMPONENT       TRUE
      INTERSTATE_COMPONENT       TRUE

      &TIDFT_OPTIMIZER_PCG
        PRECONDITIONER             QHQ_S
        EPS_ERROR                  1.0E-8
        WHICH_GRADIENT_NORM        RMS
        MAX_ITER                   50
        MAX_ITER_OUTER_LOOP        20 !100
        LIN_SEARCH_EPS_ERROR       0.2
        LIN_SEARCH_STEP_SIZE_GUESS 0.05
        CONJUGATOR                 FLETCHER
      &END TIDFT_OPTIMIZER_PCG

      &PENALTY
        INTRASTATE_NON_PENALTY_STRENGTH    1E-5
        INTERSTATE_NON_PENALTY_STRENGTH    0.1 !0.01
        PENALTY_STRENGTH_INCREASE_FACTOR   2.0
        ALLOWED_DETERMINANT_DEVIATION      1E-4
        MAX_CP_STEP                         4
        LOOSE_EPS_SCF                     1E-2
      &END PENALTY

      &WF_GUESS
        MAX_EXC_ENERGY    800
        MIN_EXC_ENERGY    0.00
        MAX_EXC_ORDER     2 !10
      &END WF_GUESS

    &END TIDFT

    &MGRID
      CUTOFF 300
    &END MGRID

    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
    &END XC

    &SCF
      SCF_GUESS ATOMIC
      EPS_SCF 1.0E-8
      MAX_SCF 50
      &OT ON
        !ALGORITHM IRAC
        !MINIMIZER DIIS
        PRECONDITIONER FULL_ALL
      &END OT
      &OUTER_SCF
         EPS_SCF 1.0E-8
         MAX_SCF 20
      &END
      &PRINT
        &RESTART OFF
        &END
      &END
    &END SCF

  &END DFT

  &SUBSYS

    &KIND O
      BASIS_SET DZVP-GTH ! TZV2P-GTH
      POTENTIAL GTH-BLYP-q6
    &END KIND

    &CELL
      ABC  8.00000000       10.00000000       9.0000000
      MULTIPLE_UNIT_CELL 1 1 1
    &END CELL

    &TOPOLOGY
      &GENERATE # fragments contain single atoms
        BONDLENGTH_MAX 1.0
        BONDPARM COVALENT
        BONDPARM_FACTOR 0.3
      &END GENERATE
      MULTIPLE_UNIT_CELL 1 1 1
    &END

    &COORD
      O     0.00000000   -0.00000000    0.50516102
      O     0.00000000    1.06551482   -0.25258050
      O    -0.00000000   -1.06551482   -0.25258050
      !C  0.00  0.00  0.00
      !O  0.00  0.00  1.16
      !O  0.00  0.00 -1.16
    &END COORD

  &END SUBSYS

&END FORCE_EVAL

