&GLOBAL
  PROJECT  diradical
  RUN_TYPE ENERGY
  PRINT_LEVEL LOW
&END GLOBAL
&FORCE_EVAL
  METHOD QS
  &DFT
    BASIS_SET_FILE_NAME GTH_BASIS_SETS
    POTENTIAL_FILE_NAME POTENTIAL
    &MGRID
      CUTOFF 300
      NGRIDS 4
    &END MGRID
    CHARGE               0
    MULTIPLICITY         3
    ROKS                 T
    UKS                  F ! RZK: Perform several sets of calculations:
                           !   1. UKS=T, ROKS=F, MULTIPLICITY=1; singlet (compare to OT)
                           !   2. UKS=T, ROKS=F, MULTIPLICITY=3; triplet (compare to OT)
                           !   3. UKS=F, ROKS=T, SPIN_PURE=F, MULTIPLICITY=1
                           !   4. UKS=F, ROKS=T, SPIN_PURE=F, MULTIPLICITY=3
                           !   5. UKS=F, ROKS=T, SPIN_PURE=T, MULTIPLICITY=1
    &QS
      TIDFT  T
      EPS_DEFAULT 1.0E-12
    &END QS

    &TIDFT
      N_EXCITED_STATES           0
      SUGGESTED_MO_BLOCK_SIZE    34
      EPS_FILTER                 1.0E-11
      SPIN_PURE                  FALSE
      MAX_UNPAIR                 0
      MO_GUESS_RANDOM_FRAC       0.05
      MO_GUESS_RANDOM_SEED       30304
      STATE_BY_STATE             TRUE
      PRE_ORTHOGONALIZE_STATES   FALSE
      NUMERICAL_GRADIENT         FALSE
      NUMERICAL_GRADIENT_DX      1E-6
      ENERGY_COMPONENT           TRUE
      INTRASTATE_COMPONENT       TRUE
      INTERSTATE_COMPONENT       TRUE

      &TIDFT_OPTIMIZER_PCG
        PRECONDITIONER             QHQ_S
        EPS_ERROR                  1.0E-8
        MAX_ITER                   50
        MAX_ITER_OUTER_LOOP        100
        LIN_SEARCH_EPS_ERROR       0.2
        LIN_SEARCH_STEP_SIZE_GUESS 0.05
        CONJUGATOR                 FLETCHER
      &END TIDFT_OPTIMIZER_PCG

      &PENALTY
        INTRASTATE_NON_PENALTY_STRENGTH    1E-5
        INTERSTATE_NON_PENALTY_STRENGTH    1
        PENALTY_STRENGTH_INCREASE_FACTOR   2.0
        ALLOWED_DETERMINANT_DEVIATION      1E-4
        MAX_CP_STEP                        3
        LOOSE_EPS_SCF                      1E-2
      &END PENALTY

    &END TIDFT

    &SCF
      SCF_GUESS ATOMIC
      EPS_SCF 1.0E-8
      MAX_SCF 30
      &OT ON
        !ALGORITHM IRAC
        !MINIMIZER DIIS
        PRECONDITIONER FULL_ALL
      &END OT
      &OUTER_SCF
         EPS_SCF 1.0E-8
         MAX_SCF 5
      &END
      &PRINT
        &RESTART OFF
        &END
      &END
    &END SCF
    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &SUBSYS
    &CELL
      ABC 10.0 10.0 10.0
      MULTIPLE_UNIT_CELL 1 1 1
    &END CELL
    &TOPOLOGY
      MULTIPLE_UNIT_CELL 1 1 1
    &END
    ! Geometry is taken from DOI: 10.1021/jp109280y
    &COORD
      C    0.00000000    0.00000000    0.14113284
      H    0.00000000    1.04918899   -0.27851281
      H    0.00000000   -1.04918899   -0.27851281
    &END COORD
    &KIND C
      BASIS_SET DZVP-GTH   ! RZK: use larger basis set
      POTENTIAL GTH-BLYP-q4
      &BS
        &ALPHA       ! Modification to the spin-up initial MOs
           NEL     +1    ! Carbon recieves one electron from hydrogen
           N        2
           L        1
        &END ALPHA
        &BETA        ! Modification to the spin-down initial MOs
           NEL      0    ! Nothing is transferred in the beta-channel
           N        2
           L        1
        &END BETA
      &END BS
    &END KIND
    &KIND H
      BASIS_SET DZVP-GTH   ! RZK: larger
      POTENTIAL GTH-BLYP-q1
      &BS
        &ALPHA
           NEL     +1    ! Hydrogen sends one electron to carbon
           N        2
           L        1
        &END ALPHA
        &BETA
           NEL      0
           N        2
           L        1
        &END BETA
      &END BS
    &END KIND
  &END SUBSYS
&END FORCE_EVAL

