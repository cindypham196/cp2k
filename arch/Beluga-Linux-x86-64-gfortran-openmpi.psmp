# Beluga:
# module --force purge
# module load ENV/gcc.7.3.0

CC       = gcc
CPP      =
FC       = mpifort
LD       = mpifort
AR       = ar -r

DFLAGS   = -D__parallel -D__SCALAPACK
DFLAGS     += -D__MKL
DFLAGS     += -D__GFORTRAN
DFLAGS     += -D__FFTW3
#DFLAGS     += -D__LIBXC
#DFLAGS     += -D__LIBINT
DFLAGS     += -D__LIBXSMM

CPPFLAGS   = -C -traditional -fopenmp $(DFLAGS)
CFLAGS     = -C -fopenmp $(DFLAGS)

FCFLAGS    = $(DFLAGS) -O3 -ffree-form -ffree-line-length-none
FCFLAGS    += -ftree-vectorize -funroll-loops
FCFLAGS    += -fopenmp
FCFLAGS    += -march=native -std=f2008 -m64 -I${MKLROOT}/include
FCFLAGS    += -I$(EBROOTFFTW)/include
#FCFLAGS    += -I$(EBROOTLIBXC)/include
#FCFLAGS    += -I$(EBROOTLIBINT)/include
FCFLAGS    += -I$(EBROOTLIBXSMM)/include

LDFLAGS    = $(FCFLAGS) -static-libgfortran

LIBS       = -L${MKLROOT}/lib/intel64 -lmkl_scalapack_lp64 -Wl,--start-group -lmkl_gf_lp64 -lmkl_gnu_thread -lmkl_core -lmkl_blacs_openmpi_lp64 -Wl,--end-group -lpthread -lm -ldl
LIBS       += -lfftw3 -lfftw3_threads
#LIBS       += -lxcf03 -lxc
#LIBS       += -lint2 -lstdc++
LIBS       += -lxsmmf -lxsmm

OBJECTS_ARCHITECTURE = machine_intel.o

